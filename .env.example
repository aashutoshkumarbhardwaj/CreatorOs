# ----------------------------------------------------
# CreatorOS - Environment Variables Template
# ----------------------------------------------------

# --- REQUIRED VARIABLES ---
# The application will fail to start fully or operate core features without these.

# MongoDB Connection String (e.g. mongodb+srv://... or mongodb://mongodb:27017/creatoros for Docker Dev)
MONGODB_URI= your_mongodb_url

# Secret key for JWT signing (Primary authentication token signature)
JWT_SECRET=your_jwt_secret_key

# Secret key for Express Sessions (Session security & Passport middleware)
SESSION_SECRET=your_session_secret_key

# Default Port (Fallback is 3000)
PORT=3000

# Server Environment (development, production)
NODE_ENV=development

# --- OPTIONAL VARIABLES (Graceful Degradation Supported) ---
# The application will still start and run without these, disabling specific features.

# Base URL for the application (e.g., https://creatoros.com)
APP_URL=
BASE_URL=

# OpenAI API Key (For AI content suggestions)
# If missing, AI features return an unavailable error unless template mode is enabled.
OPENAI_API_KEY=

# Explicit offline template mode for /suggestions.
# When true, missing/failing AI provider returns labelled template captions/hashtags (no invented songs).
# When false/unset, provider failures surface a retryable unavailable state instead of fake success.
SUGGESTIONS_TEMPLATE_MODE=false

# Redis Connection String (For BullMQ and Caching)
# If missing, background workers and queues may be disabled gracefully.
REDIS_URI=

# Stripe Configuration (For Billing and Subscriptions)
STRIPE_SECRET_KEY=
STRIPE_PRO_PRICE_ID=
STRIPE_WEBHOOK_SECRET=

# Google OAuth Credentials (Optional SSO via Passport.js for "Continue with Google")
# If unconfigured, Google login is disabled and primary JWT login/signup remains fully functional.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=

# Instagram Graph API Config
INSTAGRAM_APP_SECRET=
INSTAGRAM_WEBHOOK_VERIFY_TOKEN=creatoros-verify-token
INSTAGRAM_LOOKUP_COOLDOWN_SECONDS=30

# Dev-only cookie security override
COOKIE_SECURE_DEV=false
