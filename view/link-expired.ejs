<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Link Expired</title>
    <style nonce="<%= nonce %>">
      body {
        font-family: "Space Grotesk", sans-serif;
        background: #f5f1ea;
        display: flex;
        align-items: center;
        justify-content: center;
        min-height: 100vh;
        margin: 0;
      }
      .box {
        background: #fff;
        border: 2px solid #111;
        box-shadow: 5px 5px 0px #111;
        padding: 2rem;
        width: 90%;
        max-width: 380px;
        text-align: center;
      }
      h1 {
        font-size: 1.2rem;
        margin-bottom: 0.5rem;
      }
      p {
        font-size: 0.85rem;
        color: #555;
      }
    </style>
  </head>
  <body>
    <div class="box">
      <h1>⏳ This link has expired</h1>
      <p>
        The creator set an expiration date on this shortlink and it's no longer
        active.
      </p>
    </div>
  </body>
</html>
