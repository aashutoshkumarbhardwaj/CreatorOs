<% 
  const currentProfile = (typeof bioProfile !== 'undefined' && bioProfile) ? bioProfile : {};
  const currentHandle = currentProfile.handle || user.handle || (user.name ? user.name.toLowerCase().replace(/\s+/g,'-') : 'creator');
  const currentName = currentProfile.name || user.name || '';
  const currentBio = currentProfile.bio !== undefined ? currentProfile.bio : (user.bio || '');
  const currentAvatar = currentProfile.avatarUrl || user.avatar || null;
%>

<%- include('partials/layout/header', {
    activeNav: 'smart-bio',
    title: 'Smart Bio Editor',
    extraHead: `
        <link href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&display=swap" rel="stylesheet">
        <link rel="stylesheet" href="/css/bio-editor.css">
    `
}) %>

<div class="bio-editor-container">

    <!-- TOPBAR -->
    <header class="topbar">
      <h2>Smart Bio Editor</h2>
      <div class="share-url">
        <span>creatoros.com/<strong>@<%= currentHandle %></strong></span>
        <button type="button" class="copy-btn" onclick="copyUrl()">Copy</button>
      </div>
      <div class="topbar-actions">
        <a href="/@<%= currentHandle %>" id="previewLink" target="_blank" class="btn-retro">Preview ↗</a>
        <button type="button" class="btn-retro primary" onclick="saveBio()">Save Changes</button>
      </div>
    </header>

    <!-- CONTENT -->
    <div class="content">

      <!-- EDITOR PANEL -->
      <div class="editor-panel">

        <!-- Profile Info -->
        <div class="panel-box">
          <div class="panel-head">
            <h3>Profile</h3>
            <button type="button" class="btn-retro" style="font-size:0.72rem; padding:0.25rem 0.65rem;" onclick="document.getElementById('avatarInput').click()">Upload Photo</button>
            <input type="file" id="avatarInput" accept="image/*" style="display:none" onchange="previewAvatar(this)">
          </div>
          <div class="panel-body">
            <div class="field-row">
              <div class="field">
                <label>Display Name</label>
                <input type="text" id="profileName" value="<%= currentName %>" placeholder="Your name" oninput="updatePreview()" />
              </div>
              <div class="field">
                <label>Handle</label>
                <input type="text" id="profileHandle" value="<%= currentHandle %>" placeholder="handle" oninput="handleInputChanged()" />
                <span id="handleFeedback" style="font-size: 0.72rem; font-family:'DM Mono',monospace; margin-top: 0.2rem; display: block;"></span>
              </div>
            </div>
            <div class="field">
              <label>Bio</label>
              <textarea id="profileBio" placeholder="Short description about you..." oninput="updatePreview()"><%= currentBio %></textarea>
            </div>
            <div class="field">
              <label>Tags (press Enter to add)</label>
              <div class="tags-wrap" id="tagsWrap" onclick="document.getElementById('tagInput').focus()">
                <input type="text" id="tagInput" class="tag-input" placeholder="Add tag..." onkeydown="handleTagKey(event)" />
              </div>
            </div>
          </div>
        </div>

        <!-- Links Editor -->
        <div class="panel-box">
          <div class="panel-head">
            <h3>Links</h3>
            <span style="font-family:'DM Mono',monospace; font-size:0.72rem; color:var(--muted);" id="linkCount">0 links</span>
          </div>
          <div class="panel-body">

            <!-- Quick add presets -->
            <div class="field">
              <label>Quick Add</label>
              <div class="presets">
                <button type="button" class="preset-btn" onclick="addPreset('instagram','📸','Instagram','https://instagram.com/','social')">📸 Instagram</button>
                <button type="button" class="preset-btn" onclick="addPreset('youtube','🎥','YouTube','https://youtube.com/','social')">🎥 YouTube</button>
                <button type="button" class="preset-btn" onclick="addPreset('github','💻','GitHub','https://github.com/','work')">💻 GitHub</button>
                <button type="button" class="preset-btn" onclick="addPreset('linkedin','💼','LinkedIn','https://linkedin.com/in/','work')">💼 LinkedIn</button>
                <button type="button" class="preset-btn" onclick="addPreset('portfolio','🌐','Portfolio','https://','work')">🌐 Portfolio</button>
                <button type="button" class="preset-btn" onclick="addPreset('resume','📄','Resume','https://','work')">📄 Resume</button>
                <button type="button" class="preset-btn" onclick="addPreset('email','📧','Email','mailto:','other')">📧 Email</button>
                <button type="button" class="preset-btn" onclick="addPreset('whatsapp','💬','WhatsApp','https://wa.me/','other')">💬 WhatsApp</button>
              </div>
            </div>

            <!-- Links list -->
            <div class="links-list" id="linksList"></div>

            <button type="button" class="add-link-btn" onclick="addCustomLink()">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
              Add Custom Link
            </button>
          </div>
        </div>

        <!-- Theme & Layout -->
        <div class="panel-box">
          <div class="panel-head"><h3>Appearance</h3></div>
          <div class="panel-body">
            <div class="field">
              <label>Theme</label>
              <div class="presets">
                <button type="button" class="preset-btn" id="theme-light"   onclick="selectTheme('light',this)">☀ Light</button>
                <button type="button" class="preset-btn" id="theme-dark"    onclick="selectTheme('dark',this)">● Dark</button>
                <button type="button" class="preset-btn" id="theme-neon"    onclick="selectTheme('neon',this)">⚡ Neon</button>
                <button type="button" class="preset-btn" id="theme-gradient" onclick="selectTheme('gradient',this)">◈ Gradient</button>
              </div>
            </div>
            <div class="field">
              <label>Layout</label>
              <div class="presets">
                <button type="button" class="preset-btn" id="layout-list"  onclick="selectLayout('list',this)">≡ List</button>
                <button type="button" class="preset-btn" id="layout-grid"  onclick="selectLayout('grid',this)">⊞ Grid</button>
                <button type="button" class="preset-btn" id="layout-cards" onclick="selectLayout('cards',this)">▤ Cards</button>
              </div>
            </div>
          </div>
        </div>

      </div>

      <!-- PREVIEW PANEL -->
      <div class="preview-panel">
        <div class="preview-header">
          <span>Live Preview</span>
          <span style="font-family:'DM Mono',monospace; font-size:0.65rem; color:var(--muted);">Mobile view</span>
        </div>
        <div class="preview-frame-wrap">
          <div class="preview-inner" id="previewInner">
            <div class="prev-profile">
              <div class="prev-avatar" id="prevAvatar">S</div>
              <div class="prev-name"   id="prevName">Your Name</div>
              <div class="prev-handle" id="prevHandle">@handle</div>
              <div class="prev-bio"    id="prevBio">Your bio goes here...</div>
            </div>
            <div class="prev-links" id="prevLinks"></div>
            <div style="font-size:0.65rem; color:var(--muted); margin-top:0.5rem;">
              Powered by <strong style="color:var(--accent);">CreatorOS</strong>
            </div>
          </div>
        </div>
      </div>

    </div><!-- /content -->
</div><!-- /bio-editor-container -->

<div class="toast" id="toast">✓ Saved!</div>

<script nonce="<%= nonce %>">
  const initialProfile = <%- JSON.stringify(currentProfile) %>;
  let links = Array.isArray(initialProfile.links) && initialProfile.links.length > 0
    ? initialProfile.links.map((l, i) => ({ id: i + 1, ...l }))
    : [];
  let linkIdCounter = links.length;
  let currentTheme = initialProfile.theme || 'light';
  let currentLayout = initialProfile.layout || 'list';
  let tags = Array.isArray(initialProfile.tags) ? [...initialProfile.tags] : [];
  let avatarDataUrl = initialProfile.avatarUrl || null;

  // Initialize theme & layout buttons
  document.addEventListener('DOMContentLoaded', () => {
    const themeBtn = document.getElementById('theme-' + currentTheme) || document.getElementById('theme-light');
    if (themeBtn) selectTheme(currentTheme, themeBtn);

    const layoutBtn = document.getElementById('layout-' + currentLayout) || document.getElementById('layout-list');
    if (layoutBtn) selectLayout(currentLayout, layoutBtn);

    // Initialize tags UI
    tags.forEach(t => renderTagChip(t));

    // Initialize avatar if present
    if (avatarDataUrl) {
      const av = document.getElementById('prevAvatar');
      av.style.backgroundImage = `url(${avatarDataUrl})`;
      av.style.backgroundSize = 'cover';
      av.textContent = '';
    }

    renderLinks();
    updatePreview();
  });

  // ── LINKS ──
  function addPreset(type, icon, label, urlPrefix, category) {
    addLink({ type, icon, label, url: urlPrefix, category });
  }

  function addCustomLink() {
    addLink({ type: 'custom', icon: '🔗', label: 'My Link', url: 'https://', category: 'other' });
  }

  function addLink(data) {
    const id = ++linkIdCounter;
    links.push({ id, ...data });
    renderLinks();
    updatePreview();
  }

  function removeLink(id) {
    links = links.filter(l => l.id !== id);
    renderLinks();
    updatePreview();
  }

  function renderLinks() {
    const list = document.getElementById('linksList');
    document.getElementById('linkCount').textContent = `${links.length} link${links.length !== 1 ? 's' : ''}`;
    list.innerHTML = links.map(link => `
      <div class="link-row" id="link-row-${link.id}">
        <div class="link-row-icon">${link.icon || '🔗'}</div>
        <input type="text" value="${link.label || ''}"
               onchange="updateLinkField(${link.id},'label',this.value)"
               placeholder="Label" />
        <input type="text" value="${link.url || ''}"
               onchange="updateLinkField(${link.id},'url',this.value)"
               placeholder="https://..." />
        <button type="button" class="link-row-del" onclick="removeLink(${link.id})" title="Remove">×</button>
      </div>
    `).join('');
  }

  function updateLinkField(id, field, value) {
    const link = links.find(l => l.id === id);
    if (link) { link[field] = value; updatePreview(); }
  }

  // ── TAGS ──
  function handleTagKey(e) {
    if (e.key === 'Enter' && e.target.value.trim()) {
      e.preventDefault();
      const text = e.target.value.trim();
      if (!tags.includes(text)) {
        tags.push(text);
        renderTagChip(text);
      }
      e.target.value = '';
    }
  }

  function renderTagChip(text) {
    const wrap = document.getElementById('tagsWrap');
    const input = document.getElementById('tagInput');
    const chip = document.createElement('span');
    chip.className = 'tag-chip';
    chip.innerHTML = `${text} <button type="button" onclick="removeTag('${text}', this)">×</button>`;
    wrap.insertBefore(chip, input);
  }

  function removeTag(text, btn) {
    tags = tags.filter(t => t !== text);
    btn.parentElement.remove();
  }

  // ── HANDLE AVAILABILITY ──
  let handleCheckTimeout = null;
  function handleInputChanged() {
    updatePreview();
    const handleInput = document.getElementById('profileHandle');
    const feedback = document.getElementById('handleFeedback');
    const rawVal = handleInput.value.trim().toLowerCase().replace(/^@/, '');
    
    if (handleCheckTimeout) clearTimeout(handleCheckTimeout);
    if (!rawVal) {
      feedback.textContent = '';
      return;
    }

    handleCheckTimeout = setTimeout(() => {
      fetch(`/bio/check-handle/${encodeURIComponent(rawVal)}`)
        .then(r => r.json())
        .then(res => {
          if (res.available) {
            feedback.style.color = 'var(--accent, #37D6C8)';
            feedback.textContent = '✓ Available';
            document.getElementById('previewLink').href = `/@${res.handle}`;
          } else {
            feedback.style.color = '#ff4757';
            feedback.textContent = `✗ ${res.reason}`;
          }
        })
        .catch(() => {});
    }, 400);
  }

  // ── PREVIEW ──
  function updatePreview() {
    const nameVal = document.getElementById('profileName').value || 'Your Name';
    const handleVal = document.getElementById('profileHandle').value.trim().replace(/^@/, '') || 'handle';
    const bioVal = document.getElementById('profileBio').value || 'Your bio goes here...';

    document.getElementById('prevName').textContent   = nameVal;
    document.getElementById('prevHandle').textContent = '@' + handleVal;
    document.getElementById('prevBio').textContent    = bioVal;
    if (!avatarDataUrl) {
      document.getElementById('prevAvatar').textContent = nameVal.charAt(0).toUpperCase();
    }

    const prevLinks = document.getElementById('prevLinks');
    prevLinks.innerHTML = links.slice(0, 8).map(l => `
      <div class="prev-link">
        <span class="prev-link-icon">${l.icon || '🔗'}</span>
        <span>${l.label || 'Link'}</span>
      </div>
    `).join('');
  }

  // ── THEME ──
  function selectTheme(theme, btn) {
    currentTheme = theme;
    document.querySelectorAll('[id^="theme-"]').forEach(b => b.classList.remove('active'));
    if (btn) btn.classList.add('active');
    document.getElementById('previewInner').setAttribute('data-theme-preview', theme);
  }

  // ── LAYOUT ──
  function selectLayout(layout, btn) {
    currentLayout = layout;
    document.querySelectorAll('[id^="layout-"]').forEach(b => b.classList.remove('active'));
    if (btn) btn.classList.add('active');
  }

  // ── SAVE ──
  function saveBio() {
    const data = {
      name:   document.getElementById('profileName').value,
      handle: document.getElementById('profileHandle').value.trim().replace(/^@/, ''),
      bio:    document.getElementById('profileBio').value,
      tags,
      links,
      theme:  currentTheme,
      layout: currentLayout,
      avatarUrl: avatarDataUrl
    };

    fetch('/bio/save', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(data),
    })
    .then(r => r.json())
    .then(res => {
      if (res.success) {
        showToast('✓ Saved successfully!');
        if (res.data && res.data.handle) {
          document.getElementById('previewLink').href = `/@${res.data.handle}`;
        }
      } else {
        showToast(`❌ Error: ${res.message || 'Failed to save'}`);
      }
    })
    .catch(() => showToast('❌ Saved failed. Check connection.'));
  }

  // ── COPY URL ──
  function copyUrl() {
    const handle = document.getElementById('profileHandle').value.trim().replace(/^@/, '') || 'handle';
    navigator.clipboard.writeText(`${window.location.origin}/@${handle}`).catch(() => {});
    showToast('Link copied to clipboard!');
  }

  // ── AVATAR PREVIEW ──
  function previewAvatar(input) {
    const file = input.files[0];
    if (!file) return;
    const reader = new FileReader();
    reader.onload = e => {
      avatarDataUrl = e.target.result;
      const av = document.getElementById('prevAvatar');
      av.style.backgroundImage = `url(${avatarDataUrl})`;
      av.style.backgroundSize = 'cover';
      av.textContent = '';
    };
    reader.readAsDataURL(file);
  }

  // ── TOAST ──
  function showToast(msg) {
    const t = document.getElementById('toast');
    t.textContent = msg;
    t.classList.add('show');
    setTimeout(() => t.classList.remove('show'), 3000);
  }
</script>
<%- include('partials/layout/footer') %>

