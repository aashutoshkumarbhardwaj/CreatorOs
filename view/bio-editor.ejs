<%- include('partials/layout/header', {
    activeNav: 'smart-bio',
    title: 'Smart Bio Editor',
    extraHead: `
        <link href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&display=swap" rel="stylesheet">
        <link rel="stylesheet" href="/css/bio-editor.css">
    `
}) %>

<div class="bio-editor-container">

    <!-- TOPBAR -->
    <header class="topbar">
      <h2>Smart Bio Editor</h2>
      <div class="share-url">
        <span>creatoros.com/<strong>@<%= user.handle || user.name.toLowerCase().replace(/\s+/g,'-') %></strong></span>
        <button type="button" class="copy-btn" onclick="copyUrl()">Copy</button>
      </div>
      <div class="topbar-actions">
        <a href="/bio/preview" target="_blank" class="btn-retro">Preview ↗</a>
        <button type="button" class="btn-retro primary" onclick="saveBio()">Save Changes</button>
      </div>
    </header>

    <!-- CONTENT -->
    <div class="content">

      <!-- EDITOR PANEL -->
      <div class="editor-panel">

        <!-- Profile Info -->
        <div class="panel-box">
          <div class="panel-head">
            <h3>Profile</h3>
            <button type="button" class="btn-retro" style="font-size:0.72rem; padding:0.25rem 0.65rem;" onclick="document.getElementById('avatarInput').click()">Upload Photo</button>
            <input type="file" id="avatarInput" accept="image/*" style="display:none" onchange="previewAvatar(this)">
          </div>
          <div class="panel-body">
            <div class="field-row">
              <div class="field">
                <label>Display Name</label>
                <input type="text" id="profileName" value="<%= user.name %>" placeholder="Your name" oninput="updatePreview()" />
              </div>
              <div class="field">
                <label>Handle</label>
                <input type="text" id="profileHandle" value="<%= user.handle || user.name.toLowerCase().replace(/\s+/g,'-') %>" placeholder="@handle" oninput="updatePreview()" />
              </div>
            </div>
            <div class="field">
              <label>Bio</label>
              <textarea id="profileBio" placeholder="Short description about you..." oninput="updatePreview()"><%= user.bio || '' %></textarea>
            </div>
            <div class="field">
              <label>Tags (press Enter to add)</label>
              <div class="tags-wrap" id="tagsWrap" onclick="document.getElementById('tagInput').focus()">
                <% (bioProfile?.tags || []).forEach(tag => { %>
                  <span class="tag-chip"><%= tag %> <button type="button" onclick="this.parentElement.remove()">×</button></span>
                <% }) %>
                <input type="text" id="tagInput" class="tag-input" placeholder="Add tag..." onkeydown="handleTagKey(event)" />
              </div>
            </div>
          </div>
        </div>

        <!-- Links Editor -->
        <div class="panel-box">
          <div class="panel-head">
            <h3>Links</h3>
            <span style="font-family:'DM Mono',monospace; font-size:0.72rem; color:var(--muted);" id="linkCount">0 links</span>
          </div>
          <div class="panel-body">

            <!-- Quick add presets -->
            <div class="field">
              <label>Quick Add</label>
              <div class="presets">
                <button type="button" class="preset-btn" onclick="addPreset('instagram','📸','Instagram','https://instagram.com/','social')">📸 Instagram</button>
                <button type="button" class="preset-btn" onclick="addPreset('youtube','🎥','YouTube','https://youtube.com/','social')">🎥 YouTube</button>
                <button type="button" class="preset-btn" onclick="addPreset('github','💻','GitHub','https://github.com/','work')">💻 GitHub</button>
                <button type="button" class="preset-btn" onclick="addPreset('linkedin','💼','LinkedIn','https://linkedin.com/in/','work')">💼 LinkedIn</button>
                <button type="button" class="preset-btn" onclick="addPreset('portfolio','🌐','Portfolio','https://','work')">🌐 Portfolio</button>
                <button type="button" class="preset-btn" onclick="addPreset('resume','📄','Resume','https://','work')">📄 Resume</button>
                <button type="button" class="preset-btn" onclick="addPreset('email','📧','Email','mailto:','other')">📧 Email</button>
                <button type="button" class="preset-btn" onclick="addPreset('whatsapp','💬','WhatsApp','https://wa.me/','other')">💬 WhatsApp</button>
              </div>
            </div>

            <!-- Links list -->
            <div class="links-list" id="linksList"></div>

            <button type="button" class="add-link-btn" onclick="addCustomLink()">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
              Add Custom Link
            </button>
          </div>
        </div>

        <!-- Theme & Layout -->
        <div class="panel-box">
          <div class="panel-head"><h3>Appearance</h3></div>
          <div class="panel-body">
            <div class="field">
              <label>Theme</label>
              <div class="presets">
                <% const savedTheme = bioProfile?.theme || 'light'; %>
                <button type="button" class="preset-btn <%= savedTheme === 'light' ? 'active' : '' %>"    id="theme-light"    onclick="selectTheme('light',this)">☀ Light</button>
                <button type="button" class="preset-btn <%= savedTheme === 'dark' ? 'active' : '' %>"     id="theme-dark"     onclick="selectTheme('dark',this)">● Dark</button>
                <button type="button" class="preset-btn <%= savedTheme === 'neon' ? 'active' : '' %>"     id="theme-neon"     onclick="selectTheme('neon',this)">⚡ Neon</button>
                <button type="button" class="preset-btn <%= savedTheme === 'gradient' ? 'active' : '' %>" id="theme-gradient" onclick="selectTheme('gradient',this)">◈ Gradient</button>
              </div>
            </div>
            <div class="field">
              <label>Layout</label>
              <div class="presets">
                <% const savedLayout = bioProfile?.layout || 'list'; %>
                <button type="button" class="preset-btn <%= savedLayout === 'list' ? 'active' : '' %>"  onclick="selectLayout('list',this)">≡ List</button>
                <button type="button" class="preset-btn <%= savedLayout === 'grid' ? 'active' : '' %>"  onclick="selectLayout('grid',this)">⊞ Grid</button>
                <button type="button" class="preset-btn <%= savedLayout === 'cards' ? 'active' : '' %>" onclick="selectLayout('cards',this)">▤ Cards</button>
              </div>
            </div>
            <div class="field">
              <label>Avatar URL</label>
              <input type="text" id="avatarUrlInput" value="<%= bioProfile?.avatarUrl || '' %>" placeholder="https://..." oninput="updatePreview()" />
            </div>
            <div class="field">
              <label>Background (color or CSS gradient)</label>
              <input type="text" id="backgroundInput" value="<%= bioProfile?.background || '' %>" placeholder="#fdf6e3 or linear-gradient(...)" oninput="updatePreview()" />
            </div>
          </div>
        </div>

        <!-- Contact Button -->
        <div class="panel-box">
          <div class="panel-head"><h3>Contact Button</h3></div>
          <div class="panel-body">
            <div class="field-row">
              <div class="field">
                <label>Label</label>
                <input type="text" id="contactLabel" value="<%= bioProfile?.contactButton?.label || '' %>" placeholder="Contact Me" />
              </div>
              <div class="field">
                <label>URL (mailto:, tel:, or link)</label>
                <input type="text" id="contactUrl" value="<%= bioProfile?.contactButton?.url || '' %>" placeholder="mailto:you@example.com" />
              </div>
            </div>
          </div>
        </div>

        <!-- Domain & SEO -->
        <div class="panel-box">
          <div class="panel-head"><h3>Domain & SEO</h3></div>
          <div class="panel-body">
            <div class="field">
              <label>Custom Domain (future ready)</label>
              <input type="text" id="customDomainInput" value="<%= bioProfile?.customDomain || '' %>" placeholder="yourbrand.com" />
            </div>
            <div class="field">
              <label>SEO Title</label>
              <input type="text" id="seoTitleInput" value="<%= bioProfile?.seo?.title || '' %>" maxlength="60" placeholder="Page title for search engines" />
            </div>
            <div class="field">
              <label>SEO Description</label>
              <textarea id="seoDescInput" maxlength="160" placeholder="Short description for search engines"><%= bioProfile?.seo?.description || '' %></textarea>
            </div>
          </div>
        </div>

      </div>

      <!-- PREVIEW PANEL -->
      <div class="preview-panel">
        <div class="preview-header">
          <span>Live Preview</span>
          <span style="font-family:'DM Mono',monospace; font-size:0.65rem; color:var(--muted);">Mobile view</span>
        </div>
        <div class="preview-frame-wrap">
          <div class="preview-inner" id="previewInner">
            <div class="prev-profile">
              <div class="prev-avatar" id="prevAvatar">S</div>
              <div class="prev-name"   id="prevName">Your Name</div>
              <div class="prev-handle" id="prevHandle">@handle</div>
              <div class="prev-bio"    id="prevBio">Your bio goes here...</div>
            </div>
            <div class="prev-links" id="prevLinks"></div>
            <div style="font-size:0.65rem; color:var(--muted); margin-top:0.5rem;">
              Powered by <strong style="color:var(--accent);">CreatorOS</strong>
            </div>
          </div>
        </div>
      </div>

    </div><!-- /content -->
</div><!-- /bio-editor-container -->

<div class="toast" id="toast">✓ Saved!</div>

<script nonce="<%= nonce %>">
  const savedLinks = <%- JSON.stringify(bioProfile?.links || []) %>;
  let linkIdCounter = 0;
  let links = savedLinks.map(l => ({ ...l, id: ++linkIdCounter }));
  let currentTheme = '<%= bioProfile?.theme || "light" %>';
  let currentLayout = '<%= bioProfile?.layout || "list" %>';

  // ── LINKS ──
  function addPreset(type, icon, label, urlPrefix, category) {
    addLink({ type, icon, label, url: urlPrefix, category });
  }

  function addCustomLink() {
    addLink({ type: 'custom', icon: '🔗', label: 'My Link', url: 'https://', category: 'other' });
  }

  function addLink(data) {
    const id = ++linkIdCounter;
    links.push({ id, ...data });
    renderLinks();
    updatePreview();
  }

  function removeLink(id) {
    links = links.filter(l => l.id !== id);
    renderLinks();
    updatePreview();
  }

  function renderLinks() {
    const list = document.getElementById('linksList');
    document.getElementById('linkCount').textContent = `${links.length} link${links.length !== 1 ? 's' : ''}`;
    list.innerHTML = links.map(link => `
      <div class="link-row" id="link-row-${link.id}" draggable="true" data-id="${link.id}">
        <div class="link-row-icon">${link.icon}</div>
        <input type="text" value="${link.label}"
               onchange="updateLinkField(${link.id},'label',this.value)"
               placeholder="Label" />
        <input type="text" value="${link.url}"
               onchange="updateLinkField(${link.id},'url',this.value)"
               placeholder="https://..." />
        <button type="button" class="link-row-featured ${link.featured ? 'active' : ''}" onclick="toggleFeatured(${link.id})" title="Feature this link">★</button>
        <button type="button" class="link-row-del" onclick="removeLink(${link.id})" title="Remove">×</button>
      </div>
    `).join('');
    attachDragHandlers();
  }

  let draggedId = null;

  function attachDragHandlers() {
    const rows = document.querySelectorAll('.link-row');
    rows.forEach(row => {
      row.addEventListener('dragstart', handleDragStart);
      row.addEventListener('dragover', handleDragOver);
      row.addEventListener('dragleave', handleDragLeave);
      row.addEventListener('drop', handleDrop);
      row.addEventListener('dragend', handleDragEnd);
    });
  }

  function handleDragStart(e) {
    draggedId = Number(this.dataset.id);
    this.classList.add('dragging');
    e.dataTransfer.effectAllowed = 'move';
  }

  function handleDragOver(e) {
    e.preventDefault();
    if (Number(this.dataset.id) === draggedId) return;
    const rect = this.getBoundingClientRect();
    const midpoint = rect.top + rect.height / 2;
    this.classList.remove('drag-over-top', 'drag-over-bottom');
    if (e.clientY < midpoint) {
      this.classList.add('drag-over-top');
    } else {
      this.classList.add('drag-over-bottom');
    }
  }

  function handleDragLeave() {
    this.classList.remove('drag-over-top', 'drag-over-bottom');
  }

  function handleDrop(e) {
    e.preventDefault();
    const targetId = Number(this.dataset.id);
    this.classList.remove('drag-over-top', 'drag-over-bottom');
    if (draggedId === null || targetId === draggedId) return;

    const fromIndex = links.findIndex(l => l.id === draggedId);
    const toIndex = links.findIndex(l => l.id === targetId);
    if (fromIndex === -1 || toIndex === -1) return;

    const rect = this.getBoundingClientRect();
    const insertAfter = e.clientY > rect.top + rect.height / 2;

    const [moved] = links.splice(fromIndex, 1);
    let newIndex = links.findIndex(l => l.id === targetId);
    if (insertAfter) newIndex += 1;
    links.splice(newIndex, 0, moved);

    renderLinks();
    updatePreview();
  }

  function handleDragEnd() {
    document.querySelectorAll('.link-row').forEach(row => {
      row.classList.remove('dragging', 'drag-over-top', 'drag-over-bottom');
    });
    draggedId = null;
  }

  function updateLinkField(id, field, value) {
    const link = links.find(l => l.id === id);
    if (link) { link[field] = value; updatePreview(); }
  }

  function toggleFeatured(id) {
    const link = links.find(l => l.id === id);
    if (link) { link.featured = !link.featured; renderLinks(); updatePreview(); }
  }

  // ── TAGS ──
  const tags = <%- JSON.stringify(bioProfile?.tags || []) %>;
  function handleTagKey(e) {
    if (e.key === 'Enter' && e.target.value.trim()) {
      e.preventDefault();
      addTag(e.target.value.trim());
      e.target.value = '';
    }
  }

  function addTag(text) {
    tags.push(text);
    const wrap = document.getElementById('tagsWrap');
    const input = document.getElementById('tagInput');
    const chip = document.createElement('span');
    chip.className = 'tag-chip';
    chip.innerHTML = `${text} <button type="button" onclick="this.parentElement.remove()">×</button>`;
    wrap.insertBefore(chip, input);
  }

  // ── PREVIEW ──
  function updatePreview() {
    document.getElementById('prevName').textContent   = document.getElementById('profileName').value || 'Your Name';
    document.getElementById('prevHandle').textContent = '@' + (document.getElementById('profileHandle').value || 'handle');
    document.getElementById('prevBio').textContent    = document.getElementById('profileBio').value || 'Your bio goes here...';
    document.getElementById('prevAvatar').textContent =
      (document.getElementById('profileName').value || 'U').charAt(0).toUpperCase();

    const sortedLinks = [...links].sort((a, b) => (b.featured === true) - (a.featured === true));
    const prevLinks = document.getElementById('prevLinks');
    prevLinks.innerHTML = sortedLinks.slice(0,6).map(l => `
      <div class="prev-link ${l.featured ? 'featured' : ''}">
        <span class="prev-link-icon">${l.icon}</span>
        <span>${l.label}</span>
        ${l.featured ? '<span class="prev-link-star">★</span>' : ''}
      </div>
    `).join('');

    const bg = document.getElementById('backgroundInput').value;
    document.getElementById('previewInner').style.background = bg || '';

    const avatarUrl = document.getElementById('avatarUrlInput').value;
    const av = document.getElementById('prevAvatar');
    if (avatarUrl) {
      av.style.backgroundImage = `url(${avatarUrl})`;
      av.style.backgroundSize = 'cover';
      av.textContent = '';
    } else if (!av.style.backgroundImage.includes('base64')) {
      av.style.backgroundImage = '';
      av.textContent = (document.getElementById('profileName').value || 'U').charAt(0).toUpperCase();
    }
  }

  // ── THEME ──
  function selectTheme(theme, btn) {
    currentTheme = theme;
    document.querySelectorAll('[id^="theme-"]').forEach(b => b.classList.remove('active'));
    btn.classList.add('active');
    // Apply to preview
    document.getElementById('previewInner').setAttribute('data-theme-preview', theme);
  }

  // ── LAYOUT ──
  function selectLayout(layout, btn) {
    currentLayout = layout;
    document.querySelectorAll('.panel-body .presets .preset-btn').forEach(b => {
      if (['≡ List','⊞ Grid','▤ Cards'].includes(b.textContent)) b.classList.remove('active');
    });
    btn.classList.add('active');
    document.getElementById('prevLinks').className = 'prev-links layout-' + layout;
  }

  // ── SAVE ──
  function saveBio() {
    const data = {
      name:   document.getElementById('profileName').value,
      handle: document.getElementById('profileHandle').value,
      bio:    document.getElementById('profileBio').value,
      tags,
      links,
      theme:  currentTheme,
      layout: currentLayout,
      avatarUrl: document.getElementById('avatarUrlInput').value,
      background: document.getElementById('backgroundInput').value,
      contactButton: {
        label: document.getElementById('contactLabel').value,
        url: document.getElementById('contactUrl').value,
      },
      customDomain: document.getElementById('customDomainInput').value,
      seoTitle: document.getElementById('seoTitleInput').value,
      seoDescription: document.getElementById('seoDescInput').value,
    };

    fetch('/bio/save', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(data),
    })
    .then(r => r.json())
    .then(() => showToast('✓ Saved successfully!'))
    .catch(() => showToast('✓ Saved locally!'));
  }

  // ── COPY URL ──
  function copyUrl() {
    const handle = document.getElementById('profileHandle').value || 'handle';
    navigator.clipboard.writeText(`https://creatoros.com/@${handle}`).catch(() => {});
    showToast('Link copied to clipboard!');
  }

  // ── AVATAR PREVIEW ──
  function previewAvatar(input) {
    const file = input.files[0];
    if (!file) return;
    if (file.size > 2_000_000) {
      showToast('Image too large (max 2MB)');
      input.value = '';
      return;
    }
    const reader = new FileReader();
    reader.onload = e => {
      const av = document.getElementById('prevAvatar');
      av.style.backgroundImage = `url(${e.target.result})`;
      av.style.backgroundSize = 'cover';
      av.textContent = '';
      // Persist so it actually gets sent on save, not just previewed
      document.getElementById('avatarUrlInput').value = e.target.result;
    };
    reader.readAsDataURL(file);
  }

  // ── TOAST ──
  function showToast(msg) {
    const t = document.getElementById('toast');
    t.textContent = msg;
    t.classList.add('show');
    setTimeout(() => t.classList.remove('show'), 2500);
  }

  // Init: render seeded links and preview
  renderLinks();
  updatePreview();
  document.getElementById('previewInner').setAttribute('data-theme-preview', currentTheme);
  document.getElementById('prevLinks').className = 'prev-links layout-' + currentLayout;
  if ('<%= bioProfile?.avatarUrl || "" %>') {
    document.getElementById('prevAvatar').style.backgroundImage = "url('<%= bioProfile?.avatarUrl || "" %>')";
    document.getElementById('prevAvatar').style.backgroundSize = 'cover';
    document.getElementById('prevAvatar').textContent = '';
  }
</script>
<%- include('partials/layout/footer') %>
