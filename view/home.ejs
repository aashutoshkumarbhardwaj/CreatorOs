<!DOCTYPE html>
<html lang="en">

<head>

    <!-- SEO meta tags -->
    <%- include('./partials/_seo', {
        title: 'CreatorOS - All-in-One Creator Platform',
        description: 'CreatorOs — the all-in-one operating system for creators. Bio links, DM automation, CRM, analytics, and AI content suggestions in one dashboard.',
        canonical: 'https://titli-link-shortner.vercel.app/'}) 
    %>
    
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    
    <!-- Import Google Fonts: Space Grotesk and Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700&family=Space+Grotesk:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <div class="dashboard-layout" id="dashboardLayout">
        
        <%- include('partials/layout/sidebar', { activeNav: 'home' }) %>

        <!-- Main Workspace Panel -->
        <main class="main">
            <%- include('partials/layout/topbar', { user: typeof user !== 'undefined' ? user : { initials: 'U', name: 'User' } }) %>

            <section class="content">
                <div class="dashboard-head">
                    <div>
                        <h1>Titli Link Shortener</h1>
                        <p>Transform long links into memorable short ones with custom QR codes.</p>
                    </div>
                </div>

                <div class="analytics-grid" style="margin-top:2rem;">
                    <div style="display:flex; flex-direction:column; gap:2rem;">
                        
                        <!-- Shorten Form -->
                        <section class="panel-retro accent-blue">
                            <div class="panel-retro-title-row">
                                <h2>Shorten URL</h2>
                                <span class="badge-retro">Fast</span>
                            </div>
                            
                            <form action="/services/url-shortener/shorten" method="POST" style="display:flex; gap:0.5rem; flex-wrap:wrap; margin-top:1rem;">
                                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                <input type="url" name="redirectUrl" id="url-shortener-input" placeholder="https://your-super-long-link.com/to-shorten" required style="flex:1; border:2px solid var(--border); padding:0.9rem 1rem; font-family:'Space Grotesk',monospace; font-size:1rem; outline:none; background:var(--card-bg); color:var(--text); box-shadow:inset 2px 2px 0px rgba(0,0,0,0.05);" />
                                <button type="submit" style="background:var(--accent-teal); border:2px solid var(--border); padding:0.9rem 1.75rem; font-weight:700; font-family:'Space Grotesk',monospace; font-size:1rem; cursor:pointer; box-shadow:2px 2px 0px var(--border); color:var(--text);">SHORTEN</button>
                            </form>
                        </section>

                        <% if (locals.error) { %>
                        <section class="panel-retro" style="border-color:var(--ws-red); box-shadow:4px 4px 0 var(--ws-red);">
                            <h3 style="color:var(--ws-red);">Error</h3>
                            <p style="font-weight:700; margin-top:0.5rem;"><%= error %></p>
                        </section>
                        <% } %>

                        <% if (locals.shortUrl) { %>
                        <div style="display:grid; grid-template-columns:1fr 300px; gap:1.5rem; align-items:start;">
                            <!-- Link & Customization -->
                            <section class="panel-retro" style="display:flex; flex-direction:column; gap:1.5rem;">
                                <div class="panel-retro-title-row">
                                    <h2>Ready!</h2>
                                    <span class="badge-retro" style="background:var(--accent-yellow);">Success</span>
                                </div>
                                
                                <div style="display:flex; align-items:center; gap:0.75rem;">
                                    <div style="flex:1; padding:0.75rem 1rem; background:rgba(55,214,200,0.1); border:2px solid var(--accent-teal); font-family:'Space Grotesk',monospace; font-weight:700; color:var(--accent-teal); display:flex; align-items:center; gap:0.5rem;">
                                        <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.1-1.1m-.758-4.9a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1"/>
                                        </svg>
                                        <a href="<%= shortUrl %>" target="_blank" style="color:inherit; text-decoration:none;"><%= shortUrl %></a>
                                    </div>
                                    <button type="button" class="btn-copy" onclick="copyToClipboard('<%= shortUrl %>')" style="background:var(--bg-secondary); color:var(--text); border:2px solid var(--border); padding:0.75rem 1.5rem; font-weight:700; cursor:pointer; box-shadow:2px 2px 0px var(--border); transition:all 0.1s;">Copy</button>
                                </div>

                                <div style="border-top:2px solid var(--border); padding-top:1.5rem;">
                                    <h3 style="font-size:1.1rem; margin-bottom:1rem;">QR Customization</h3>
                                    <div style="display:flex; gap:2rem;">
                                        <div>
                                            <label style="display:block; font-family:'Space Grotesk',monospace; font-size:0.75rem; font-weight:700; text-transform:uppercase; margin-bottom:0.5rem;">Preset Colors</label>
                                            <div style="display:flex; gap:0.5rem;">
                                                <div style="width:36px; height:36px; border:2px solid var(--border); background:#1a1a1a; cursor:pointer;" onclick="applyPreset('#1a1a1a', '#ffffff')"></div>
                                                <div style="width:36px; height:36px; border:2px solid var(--border); background:#3ecfb2; cursor:pointer;" onclick="applyPreset('#3ecfb2', '#ffffff')"></div>
                                                <div style="width:36px; height:36px; border:2px solid var(--border); background:#3b82f6; cursor:pointer;" onclick="applyPreset('#3b82f6', '#ffffff')"></div>
                                                <div style="width:36px; height:36px; border:2px solid var(--border); background:#8b5cf6; cursor:pointer;" onclick="applyPreset('#8b5cf6', '#ffffff')"></div>
                                            </div>
                                        </div>
                                        <div>
                                            <label style="display:block; font-family:'Space Grotesk',monospace; font-size:0.75rem; font-weight:700; text-transform:uppercase; margin-bottom:0.5rem;">Custom</label>
                                            <div style="display:flex; gap:0.5rem;">
                                                <input type="color" id="fg-color-picker" value="#1a1a1a" onchange="updateQRColor('fg', this.value)" style="width:36px; height:36px; padding:0; border:2px solid var(--border); cursor:pointer;">
                                                <input type="color" id="bg-color-picker" value="#ffffff" onchange="updateQRColor('bg', this.value)" style="width:36px; height:36px; padding:0; border:2px solid var(--border); cursor:pointer;">
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </section>

                            <!-- QR & Export -->
                            <section class="stat-card-retro" style="align-items:center;">
                                <span class="card-id">QR ASSET</span>
                                <div style="border:3px solid var(--accent-teal); border-radius:4px; padding:1rem; background:#fff; margin:1rem 0;">
                                    <div id="qr-canvas"></div>
                                </div>
                                <span class="subtext">Scan to Discover</span>

                                <div style="width:100%; margin-top:1.5rem; border-top:2px dashed var(--border); padding-top:1rem; display:flex; flex-direction:column; gap:0.5rem;">
                                    <div style="display:flex; gap:0.5rem;">
                                        <a id="download-png" download="titli-qr.png" style="flex:1; text-align:center; background:var(--bg-secondary); color:var(--text); border:2px solid var(--border); padding:0.5rem; font-size:0.8rem; font-weight:700; text-decoration:none; cursor:pointer;">PNG</a>
                                        <a id="download-svg" download="titli-qr.svg" style="flex:1; text-align:center; background:var(--bg-secondary); color:var(--text); border:2px solid var(--border); padding:0.5rem; font-size:0.8rem; font-weight:700; text-decoration:none; cursor:pointer;">SVG</a>
                                    </div>
                                    <a id="download-main" download="titli-qr.png" style="width:100%; text-align:center; background:var(--text); color:var(--bg); border:2px solid var(--border); padding:0.75rem; font-size:0.9rem; font-weight:700; text-decoration:none; cursor:pointer; margin-top:0.25rem;">
                                        Save &amp; Download
                                    </a>
                                </div>
                            </section>
                        </div>
                        <% } %>
                    </div>
                </div>
                
                <!-- Features Grid -->
                <section class="panel-retro" style="margin-top:2rem;">
                    <div class="panel-retro-title-row">
                        <h2>Features</h2>
                        <span class="badge-retro">Built-in</span>
                    </div>
                    <div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(250px, 1fr)); gap:1.5rem; margin-top:1rem;">
                        <article class="stat-card-retro" style="box-shadow:none;">
                            <span class="label" style="font-size:1.1rem; margin-bottom:0.5rem;">Custom Links</span>
                            <span class="subtext">Create branded, memorable links that increase click-through rates.</span>
                        </article>
                        <article class="stat-card-retro" style="box-shadow:none;">
                            <span class="label" style="font-size:1.1rem; margin-bottom:0.5rem;">Detailed Analytics</span>
                            <span class="subtext">Track every click with our easy-to-understand analytics dashboard.</span>
                        </article>
                        <article class="stat-card-retro" style="box-shadow:none;">
                            <span class="label" style="font-size:1.1rem; margin-bottom:0.5rem;">Fast & Reliable</span>
                            <span class="subtext">Global infrastructure ensures quick, reliable redirects every time.</span>
                        </article>
                    </div>
                </section>
            </section>
        </main>
    </div>

    <!-- Scripts -->
    <script>
        const sidebarToggle = document.getElementById('sidebarToggle');
        const dashboardLayout = document.getElementById('dashboardLayout');
        

        if (sidebarToggle && dashboardLayout) {
            sidebarToggle.addEventListener('click', () => {
                dashboardLayout.classList.toggle('sidebar-collapsed');
            });
        }

        const themeBtn = document.getElementById('theme-toggle');
        const root = document.documentElement;
        const iconLight = themeBtn ? themeBtn.querySelector('.icon-light') : null;
        const iconDark = themeBtn ? themeBtn.querySelector('.icon-dark') : null;
        
        function applyTheme(isDark) {
            if (isDark) {
                root.setAttribute('data-theme', 'dark');
                if (iconLight) iconLight.style.display = 'none';
                if (iconDark) iconDark.style.display = 'block';
            } else {
                root.removeAttribute('data-theme');
                if (iconLight) iconLight.style.display = 'block';
                if (iconDark) iconDark.style.display = 'none';
            }
        }

        if (themeBtn) {
            if (localStorage.getItem('theme') === 'dark') {
                applyTheme(true);
            } else {
                applyTheme(false);
            }

            themeBtn.addEventListener('click', () => {
                const isDark = root.getAttribute('data-theme') === 'dark';
                applyTheme(!isDark);
                localStorage.setItem('theme', !isDark ? 'dark' : 'light');
                window.dispatchEvent(new Event('themeChanged'));
            });
        }
    </script>

    <!-- QR Code Script (Pulled exactly from old home.ejs) -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>
    <script>
        var qrState = {
            url: '<%= locals.shortUrl || "" %>',
            fgColor: '#1a1a1a',
            bgColor: '#ffffff'
        };
        var qrCodeInstance = null;

        function generateQR() {
            if (!qrState.url) return;
            var container = document.getElementById('qr-canvas');
            if (!container) return;
            container.innerHTML = '';
            
            try {
                qrCodeInstance = new QRCode(container, {
                    text: qrState.url,
                    width: 180,
                    height: 180,
                    colorDark: qrState.fgColor,
                    colorLight: qrState.bgColor,
                    correctLevel: QRCode.CorrectLevel.H
                });
                setTimeout(updateDownloadLinks, 150);
            } catch (err) {
                console.error('QR Code generation error:', err);
            }
        }

        function updateDownloadLinks() {
            var container = document.getElementById('qr-canvas');
            if (!container) return;
            var canvas = container.querySelector('canvas');
            var img = container.querySelector('img');
            var dataUrl = null;
            
            if (canvas) {
                dataUrl = canvas.toDataURL('image/png');
            } else if (img) {
                var tempCanvas = document.createElement('canvas');
                tempCanvas.width = 180;
                tempCanvas.height = 180;
                var ctx = tempCanvas.getContext('2d');
                ctx.drawImage(img, 0, 0, 180, 180);
                dataUrl = tempCanvas.toDataURL('image/png');
            }

            if (dataUrl) {
                var pngLink = document.getElementById('download-png');
                var mainLink = document.getElementById('download-main');
                if (pngLink) pngLink.href = dataUrl;
                if (mainLink) mainLink.href = dataUrl;
            }

            var svgLink = document.getElementById('download-svg');
            if (svgLink && qrState.url) {
                var svgString = '<svg xmlns="http://www.w3.org/2000/svg" width="180" height="180" viewBox="0 0 180 180"><rect width="180" height="180" fill="' + qrState.bgColor + '"/><text x="90" y="95" font-family="system-ui, sans-serif" font-size="12" font-weight="bold" text-anchor="middle" fill="' + qrState.fgColor + '">QR Asset</text></svg>';
                var svgBlob = new Blob([svgString], { type: 'image/svg+xml' });
                var svgUrl = URL.createObjectURL(svgBlob);
                svgLink.href = svgUrl;
            }
        }

        function updateQRColor(type, color) {
            if (type === 'fg') {
                qrState.fgColor = color;
                var fgPicker = document.getElementById('fg-color-picker');
                if (fgPicker) fgPicker.value = color;
            } else {
                qrState.bgColor = color;
                var bgPicker = document.getElementById('bg-color-picker');
                if (bgPicker) bgPicker.value = color;
            }
            generateQR();
        }

        function applyPreset(fg, bg) {
            qrState.fgColor = fg;
            qrState.bgColor = bg;
            var fgPicker = document.getElementById('fg-color-picker');
            var bgPicker = document.getElementById('bg-color-picker');
            if (fgPicker) fgPicker.value = fg;
            if (bgPicker) bgPicker.value = bg;
            generateQR();
        }

        function copyToClipboard(text) {
            navigator.clipboard.writeText(text).then(function() {
                var btn = document.querySelector('.btn-copy');
                if (btn) {
                    btn.textContent = 'Copied!';
                    setTimeout(function() {
                        btn.textContent = 'Copy';
                    }, 2000);
                }
            });
        }

        document.addEventListener('DOMContentLoaded', function() {
            if (qrState.url) {
                setTimeout(function() {
                    if (typeof QRCode !== 'undefined') {
                        generateQR();
                    }
                }, 150);
            }
        });
    </script>

    <script type="application/ld+json">
    {
        "@context": "https://schema.org",
        "@type": "SoftwareApplication",
        "name": "CreatorOS - Link Shortener & Creator Platform",
        "url": "https://titli-link-shortner.vercel.app/",
        "description": "All-in-one creator platform with bio links, CRM, analytics, and automation tools.",
        "applicationCategory": "BusinessApplication",
        "operatingSystem": "Web"
    }
    </script>
    <%- include('partials/layout/scripts') %>
</body>
</html>
