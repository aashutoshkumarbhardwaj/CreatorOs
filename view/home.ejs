<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <title>Titli - Elegant Link Shortener</title>
    <link href="/css/style.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600;700&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Poppins', sans-serif; }
        .gradient-bg { background: linear-gradient(135deg, #1e3a8a, #3b0764); }
        .glass-card {
            background: rgba(255, 255, 255, 0.05);
            backdrop-filter: blur(10px);
            border: 1px solid rgba(255, 255, 255, 0.1);
        }
        .animation-delay-2000 { animation-delay: 2s; }
        .animation-delay-4000 { animation-delay: 4s; }
        @keyframes blob {
            0%   { transform: translate(0px, 0px) scale(1); }
            33%  { transform: translate(30px, -50px) scale(1.1); }
            66%  { transform: translate(-20px, 20px) scale(0.9); }
            100% { transform: translate(0px, 0px) scale(1); }
        }

        /* ── QR Result Card ───────────────────────────────── */
        .result-card {
            margin-top: 2rem;
            max-width: 480px;
            margin-left: auto;
            margin-right: auto;
            border-radius: 1rem;
            padding: 1.5rem;
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 1.2rem;
        }
        .result-url-row {
            width: 100%;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 0.75rem;
            background: rgba(255,255,255,0.06);
            border-radius: 0.65rem;
            padding: 0.75rem 1rem;
        }
        .result-url-row a {
            color: #67e8f9;
            font-weight: 700;
            font-size: 1.05rem;
            word-break: break-all;
            text-decoration: none;
        }
        .result-url-row a:hover { color: #a5f3fc; }
        .copy-btn {
            flex-shrink: 0;
            padding: 0.45rem 1rem;
            border: none;
            border-radius: 999px;
            background: #22d3ee;
            color: #042f3e;
            font-weight: 700;
            font-size: 0.85rem;
            cursor: pointer;
            transition: background 0.18s, transform 0.18s;
        }
        .copy-btn:hover { background: #67e8f9; transform: translateY(-1px); }
        .qr-box {
            background: #ffffff;
            border-radius: 0.85rem;
            padding: 0.75rem;
            display: flex;
            align-items: center;
            justify-content: center;
            min-width: 180px;
            min-height: 180px;
        }
        .qr-box img { width: 160px; height: 160px; display: block; }
        .qr-spinner {
            width: 2rem;
            height: 2rem;
            border: 3px solid rgba(34,211,238,0.2);
            border-top-color: #22d3ee;
            border-radius: 999px;
            animation: spin 0.8s linear infinite;
        }
        @keyframes spin { to { transform: rotate(360deg); } }
        .qr-download-btn {
            display: inline-flex;
            align-items: center;
            gap: 0.45rem;
            padding: 0.65rem 1.4rem;
            border: none;
            border-radius: 999px;
            background: linear-gradient(135deg, #22d3ee, #38bdf8);
            color: #042f3e;
            font-weight: 700;
            font-size: 0.9rem;
            cursor: pointer;
            text-decoration: none;
            transition: transform 0.18s, box-shadow 0.18s;
        }
        .qr-download-btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 20px rgba(34,211,238,0.3);
        }
    </style>
</head>
<body class="gradient-bg text-white overflow-x-hidden">

    <!-- Header -->
    <header class="absolute top-0 left-0 w-full z-10 p-6">
        <nav class="container mx-auto flex justify-between items-center">
            <div class="text-3xl font-bold tracking-wider logo">Titli 🦋</div>
            <div class="hidden md:flex space-x-8 nav-links">
                <a href="/" class="hover:text-cyan-300 transition-colors">Service Hub</a>
                <a href="#features" class="hover:text-cyan-300 transition-colors">Features</a>
                <a href="#how-it-works" class="hover:text-cyan-300 transition-colors">How It Works</a>
            </div>
        </nav>
    </header>

    <main>
        <section class="min-h-screen flex items-center justify-center p-6 relative overflow-hidden">
            <div class="absolute inset-0 opacity-10">
                <div class="absolute top-1/4 left-1/4 w-64 h-64 bg-purple-500 rounded-full mix-blend-screen filter blur-xl animate-[blob_7s_infinite]"></div>
                <div class="absolute top-1/2 right-1/4 w-64 h-64 bg-cyan-500 rounded-full mix-blend-screen filter blur-xl animate-[blob_7s_infinite] animation-delay-2000"></div>
                <div class="absolute bottom-1/4 left-1/3 w-64 h-64 bg-indigo-500 rounded-full mix-blend-screen filter blur-xl animate-[blob_7s_infinite] animation-delay-4000"></div>
            </div>

            <div class="container mx-auto text-center z-10">
                <h1 class="text-5xl md:text-7xl font-bold mb-4 hero-title">Shorten Links, <br> Let Your Ideas Fly.</h1>
                <p class="text-lg md:text-xl text-gray-300 mb-8 max-w-2xl mx-auto hero-subtitle">
                    A simple and elegant link shortener for creators. Transform long links into memorable short ones.
                </p>

                <form action="/services/url-shortener/shorten" method="POST" class="max-w-2xl mx-auto glass-card rounded-full p-2 flex items-center shadow-lg hero-form">
                    <label for="url-shortener-input" class="sr-only">URL to Shorten</label>
                    <input
                        id="url-shortener-input"
                        type="url"
                        name="redirectUrl"
                        placeholder="https://your-super-long-link.com/to-shorten"
                        class="w-full bg-transparent text-white placeholder-gray-400 border-none focus:ring-0 py-3 px-6 text-lg"
                        required
                    >
                    <button type="submit" class="bg-cyan-500 hover:bg-cyan-400 text-white font-bold py-3 px-8 rounded-full transition-all text-lg flex-shrink-0">
                        Shorten
                    </button>
                </form>

                <!-- ── Result: Short URL + QR ──────────────────────────── -->
                <% if (locals.shortUrl) { %>
                    <% const _shortId = shortUrl.split('/').pop(); %>
                    <div class="result-card glass-card">

                        <div class="result-url-row">
                            <a href="<%= shortUrl %>" target="_blank" rel="noopener"><%= shortUrl %></a>
                            <button class="copy-btn" onclick="copyUrl('<%= shortUrl %>', this)">Copy</button>
                        </div>

                        <div class="qr-box" id="qrBox">
                            <div class="qr-spinner"></div>
                        </div>

                        <a class="qr-download-btn"
                           href="/api/urls/qr/<%= _shortId %>/download"
                           download="qr-<%= _shortId %>.png">
                            ⬇ Download QR
                        </a>

                    </div>

                    <script>
                    (function () {
                        const qrBox = document.getElementById('qrBox');
                        const img   = new Image();
                        img.alt = 'QR Code';
                        img.style.cssText = 'width:160px;height:160px;display:block;border-radius:4px;';
                        img.onload  = function () { qrBox.innerHTML = ''; qrBox.appendChild(img); };
                        img.onerror = function () { qrBox.innerHTML = '<span style="color:#f87171;font-size:0.8rem;">QR load failed</span>'; };
                        img.src = '/api/urls/qr/<%= _shortId %>';
                    })();
                    </script>
                <% } %>

                <% if (locals.error) { %>
                    <div class="mt-8 bg-red-500/20 border border-red-500 text-red-300 rounded-lg p-4 max-w-xl mx-auto">
                        <p><%= error %></p>
                    </div>
                <% } %>
            </div>
        </section>

        <!-- Features Section -->
        <section id="features" class="py-20 px-6">
            <div class="container mx-auto text-center">
                <h2 class="text-4xl font-bold mb-2 section-title">Powerful Features, Simple Interface</h2>
                <p class="text-gray-300 mb-12 max-w-xl mx-auto section-subtitle">Everything you need to make your links perform better.</p>
                <div class="grid md:grid-cols-3 gap-8">
                    <div class="glass-card p-8 rounded-2xl feature-card">
                        <div class="text-4xl mb-4">✨</div>
                        <h3 class="text-2xl font-bold mb-2">Custom Links</h3>
                        <p class="text-gray-300">Create branded, memorable links that increase click-through rates and build trust with your audience.</p>
                    </div>
                    <div class="glass-card p-8 rounded-2xl feature-card">
                        <div class="text-4xl mb-4">📊</div>
                        <h3 class="text-2xl font-bold mb-2">Detailed Analytics</h3>
                        <p class="text-gray-300">Track every click and measure your campaign's performance with our easy-to-understand analytics dashboard.</p>
                    </div>
                    <div class="glass-card p-8 rounded-2xl feature-card">
                        <div class="text-4xl mb-4">🚀</div>
                        <h3 class="text-2xl font-bold mb-2">Fast & Reliable</h3>
                        <p class="text-gray-300">Our global infrastructure ensures your links are redirected quickly and reliably, every single time.</p>
                    </div>
                </div>
            </div>
        </section>

        <!-- How It Works Section -->
        <section id="how-it-works" class="py-20 px-6">
            <div class="container mx-auto text-center">
                <h2 class="text-4xl font-bold mb-12 section-title">Get Started in Seconds</h2>
                <div class="flex flex-col md:flex-row justify-center items-center gap-8 md:gap-16">
                    <div class="flex items-center flex-col text-center step">
                        <div class="w-24 h-24 rounded-full glass-card flex items-center justify-center text-4xl font-bold border-2 border-cyan-400 mb-4">1</div>
                        <h3 class="text-xl font-semibold">Paste Your URL</h3>
                        <p class="text-gray-400 max-w-xs">Simply paste your long link into the input field.</p>
                    </div>
                    <div class="flex items-center flex-col text-center step">
                        <div class="w-24 h-24 rounded-full glass-card flex items-center justify-center text-4xl font-bold border-2 border-cyan-400 mb-4">2</div>
                        <h3 class="text-xl font-semibold">Shorten It</h3>
                        <p class="text-gray-400 max-w-xs">Click the button and let our magic create a short link.</p>
                    </div>
                    <div class="flex items-center flex-col text-center step">
                        <div class="w-24 h-24 rounded-full glass-card flex items-center justify-center text-4xl font-bold border-2 border-cyan-400 mb-4">3</div>
                        <h3 class="text-xl font-semibold">Share It</h3>
                        <p class="text-gray-400 max-w-xs">Copy your new short link and share it with the world.</p>
                    </div>
                </div>
            </div>
        </section>
    </main>

    <footer class="py-10 px-6 border-t border-white/10">
        <div class="container mx-auto text-center text-gray-400">
            <p>&copy; 2026 CreatorOS. All Rights Reserved.</p>
            <p class="mt-2">Designed with ❤️ for beautiful links.</p>
        </div>
    </footer>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/gsap.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/ScrollTrigger.min.js"></script>
    <script src="/js/pages/home.js"></script>

    <script>
    function copyUrl(url, btn) {
        navigator.clipboard.writeText(url).then(function () {
            btn.textContent = 'Copied!';
            setTimeout(function () { btn.textContent = 'Copy'; }, 2000);
        });
    }
    </script>

</body>
</html>