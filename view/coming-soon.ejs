<!DOCTYPE html>
<html lang="en">
<head>

    <!-- SEO meta tags -->
    <%- include('./partials/_seo', {
        title: service.name + ' - Coming Soon',
        description: 'This feature is currently under development and will be available soon on CreatorOS.',
        canonical: 'https://titli-link-shortner.vercel.app/coming-soon',
        robots: 'noindex,nofollow'
    }) %>
    
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <main class="card">
        <span class="badge">COMING SOON</span>
        <h1><%= service.name %></h1>
        <p><%= service.description %></p>
        <a href="/">Back to service hub</a>
    </main>
</body>
</html>
