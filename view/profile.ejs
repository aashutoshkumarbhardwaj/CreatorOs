<!DOCTYPE html>
<html lang="en">
<head>

    <!-- SEO meta tags -->
    <%- include('./partials/_seo', {
        title: 'Profile',
        description: 'Creator profile on CreatorOS.',
        canonical: 'https://titli-link-shortner.vercel.app/profile'
    }) %>
    
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;700;800&display=swap" rel="stylesheet">
    
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <main class="profile-card">
        <div class="avatar" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor">
                <path d="M20 21a8 8 0 0 0-16 0"></path>
                <circle cx="12" cy="7" r="4"></circle>
            </svg>
        </div>

        <h1><%= user.name %></h1>
        <p>Your CreatorOS account is active. More profile details can be added here as the account system grows.</p>

        <div class="profile-meta">
            <% if (user.email) { %>
                Email: <%= user.email %><br>
            <% } %>
            User ID: <%= user && user.id ? user.id : 'Authenticated user' %>
        </div>

        <div class="actions">
            <a class="btn" href="/dashboard">Back to dashboard</a>
            <a class="btn secondary" href="/logout">Logout</a>
        </div>
    </main>
</body>
</html>
