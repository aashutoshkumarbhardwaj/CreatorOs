<%- include('partials/layout/header', {
    activeNav: 'file-upload',
    title: 'File Upload',
    extraHead: '<link rel="stylesheet" href="/css/dashboard.css">'
}) %>

<section class="content">
    <div class="dashboard-head">
        <div>
            <a href="/" style="display:inline-flex; align-items:center; gap:0.5rem; font-size:0.85rem; margin-bottom:1rem; font-weight:700;">&larr; Back to services</a>
            <h1>File Upload</h1>
            <p>Drag & drop a file or click to browse. Works in all modern browsers.</p>
        </div>
    </div>

    <div style="max-width: 800px; margin: 0 auto; width: 100%;">
        <!-- Drop Zone -->
        <section class="panel-retro" id="drop-zone" style="cursor:pointer; align-items:center; justify-content:center; padding: 4rem 2rem; border-style: dashed; border-width: 3px; background-color: var(--bg-secondary); transition: all 0.2s;">
            <div id="upload-icon" style="font-size: 3rem; margin-bottom: 1rem;">📁</div>
            <h2 id="drop-text" style="margin-bottom: 0.5rem;">Drag & drop a file here</h2>
            <p id="drop-sub" style="color: var(--muted-2); font-size: 0.9rem;">or click to browse files</p>
            <label for="file-input" style="display:none;">Upload File</label>
            <input id="file-input" type="file" style="display:none;" />
        </section>

        <!-- File Info -->
        <section id="file-info" class="panel-retro bg-blue" style="display:none; flex-direction:row; justify-content:space-between; align-items:center; padding: 1rem 1.5rem; margin-top: 1.5rem; background-color: var(--accent-blue);">
            <div>
                <p id="file-name" style="font-weight:700; color:#111; margin-bottom: 0.2rem;"></p>
                <p id="file-size" style="font-size:0.8rem; color:#333; font-family:'Space Grotesk', monospace;"></p>
            </div>
            <button type="button" id="remove-file" class="primary-action-btn" style="background-color: var(--accent-red); color: white;">Remove</button>
        </section>

        <!-- Upload Button -->
        <button type="button" id="upload-btn" class="primary-action-btn" style="margin-top: 1.5rem; width: 100%; justify-content: center; font-size: 1.1rem; padding: 1rem; opacity: 0.5; cursor: not-allowed;" disabled>Select a file to upload</button>

        <!-- Progress -->
        <section id="progress-area" class="panel-retro" style="display:none; padding: 1.5rem; margin-top: 1.5rem;">
            <div style="display:flex; justify-content:space-between; margin-bottom:0.5rem; font-weight:700;">
                <span id="progress-label">Uploading...</span>
                <span id="progress-pct" style="font-family:'Space Grotesk', monospace;">0%</span>
            </div>
            <div style="width:100%; height:12px; background-color:var(--bg); border:var(--border-thick);">
                <div id="progress-bar" style="width:0%; height:100%; background-color:var(--accent-teal); transition:width 0.3s;"></div>
            </div>
        </section>

        <!-- Status -->
        <div id="status" class="message-box" style="display:none; margin-top: 1.5rem;"></div>
    </div>
</section>

<script src="/js/pages/file-upload.js"></script>

<%- include('partials/layout/footer') %>
<div id="drop-zone" class="drop-zone">
  <p>Drag & drop files here, or click to select</p>
  <input type="file" id="file-input" multiple hidden />
</div>