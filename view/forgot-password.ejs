<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('./partials/_seo', {
        title: 'Forgot Password',
        description: 'Request a password reset link for your CreatorOS account.',
        canonical: 'https://creatoros.com/forgot-password'
    }) %>
    
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <%- include('./partials/_brand_head') %>

    <link href="https://fonts.googleapis.com/css2?family=Petrona:ital,wght@0,400;0,600;0,700;1,400&family=Source+Sans+3:ital,wght@0,400;0,500;0,600;0,700;1,400&family=Azeret+Mono:wght@400;600&display=swap" rel="stylesheet">
    <style>
        :root {
            --blue-bg: #7baaf7; 
            --cream: #fdf4e3; 
            --white: #FFFFFF;
            --black: #000000;
            --teal: #34D399; 
            --teal-hover: #10B981;
            
            --border-width: 3px;
            --shadow-ink: var(--black);
            --shadow-sm: 3px 3px 0px 0px var(--shadow-ink);
            --shadow-md: 4px 4px 0px 0px var(--shadow-ink);
            --shadow-lg: 6px 6px 0px 0px var(--shadow-ink);
            
            --border-base: 2px solid var(--black);
            --border-thick: 4px solid var(--black);
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: 'Source Sans 3', sans-serif;
            color: var(--black);
            background-color: var(--cream); 
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 1.5rem;
        }

        .forgot-container {
            width: 100%;
            max-width: 480px;
            background: var(--white);
            border: var(--border-thick);
            box-shadow: var(--shadow-lg);
            padding: 2.5rem 2rem;
            position: relative;
        }

        .brand-badge {
            display: inline-flex;
            align-items: center;
            gap: 0;
            font-weight: 700;
            font-size: 1.5rem;
            text-decoration: none;
            color: var(--black);
            margin-bottom: 2rem;
            font-family: 'Petrona', serif;
            letter-spacing: -0.5px;
        }

        .brand-badge-logo {
            display: block;
            height: 40px;
            width: auto;
        }

        h1 {
            font-family: 'Petrona', serif;
            font-size: 2rem;
            font-weight: 700;
            margin-bottom: 0.5rem;
            color: var(--black);
        }

        p.subtitle {
            font-size: 1rem;
            color: #475569;
            margin-bottom: 2rem;
            line-height: 1.5;
        }

        .form-group {
            margin-bottom: 1.5rem;
        }

        label {
            display: block;
            font-family: 'Azeret Mono', monospace;
            font-size: 0.85rem;
            font-weight: 600;
            letter-spacing: 1px;
            text-transform: uppercase;
            margin-bottom: 0.5rem;
        }

        input[type="email"] {
            width: 100%;
            padding: 1rem;
            border: var(--border-base);
            font-family: 'Source Sans 3', sans-serif;
            font-size: 1rem;
            outline: none;
            transition: all 0.15s ease;
            background: var(--white);
        }

        input[type="email"]:focus {
            box-shadow: var(--shadow-sm);
            border-color: var(--black);
        }

        .primary-btn {
            width: 100%;
            background-color: var(--teal);
            border: var(--border-base);
            padding: 1rem;
            font-family: 'Azeret Mono', monospace;
            font-weight: 600;
            font-size: 1rem;
            letter-spacing: 1px;
            text-transform: uppercase;
            color: var(--black);
            cursor: pointer;
            box-shadow: var(--shadow-md);
            transition: all 0.15s ease;
            margin-top: 0.5rem;
            margin-bottom: 1.5rem;
            display: flex;
            justify-content: center;
            align-items: center;
            gap: 0.5rem;
        }

        .primary-btn:hover {
            transform: translate(-2px, -2px);
            box-shadow: var(--shadow-lg);
            background-color: var(--teal-hover);
        }

        .primary-btn:active {
            transform: translate(2px, 2px);
            box-shadow: none;
        }

        .auth-error {
            background-color: #fef2f2;
            border: 2px solid #ef4444;
            padding: 1rem;
            margin-bottom: 1.5rem;
            color: #b91c1c;
            font-weight: 600;
            box-shadow: var(--shadow-sm);
        }

        .auth-success {
            background-color: #f0fdf4;
            border: 2px solid #10b981;
            padding: 1rem;
            margin-bottom: 1.5rem;
            color: #065f46;
            font-weight: 600;
            box-shadow: var(--shadow-sm);
        }

        .back-link {
            text-align: center;
            font-weight: 600;
            font-size: 0.95rem;
        }

        .back-link a {
            color: var(--black);
            text-decoration: underline;
            text-decoration-thickness: 2px;
            text-underline-offset: 4px;
        }
    </style>
</head>
<body>
    <div class="forgot-container">
        <a href="/" class="brand-badge">
            <img class="brand-badge-logo" src="<%= BRAND.logo %>" alt="CreatorOS Logo">
        </a>

        <h1>Forgot Password?</h1>
        <p class="subtitle">Enter the email associated with your CreatorOS account and we'll send you a password reset link.</p>

        <% if (typeof error !== 'undefined' && error) { %>
            <div class="auth-error" role="alert">
                <%= error %>
            </div>
        <% } %>

        <% if (typeof success !== 'undefined' && success) { %>
            <div class="auth-success" role="alert">
                <%= success %>
            </div>
        <% } %>

        <form action="/forgot-password" method="POST" id="forgot-form">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <div class="form-group">
                <label for="forgot-email">Email Address</label>
                <input id="forgot-email" type="email" name="email" placeholder="creator@studio.com" value="<%= typeof prefilledEmail !== 'undefined' && prefilledEmail ? prefilledEmail : '' %>" required>
            </div>

            <button type="submit" class="primary-btn" data-loading-text="Sending Link...">
                Send Reset Link &rarr;
            </button>
        </form>

        <p class="back-link">
            Remember your password? <a href="/login">Back to Login</a>
        </p>
    </div>

    <script>
        const forgotForm = document.getElementById('forgot-form');
        let loading = false;
        forgotForm?.addEventListener('submit', function() {
            if (loading) return false;
            loading = true;
            const btn = this.querySelector('button[type="submit"]');
            if (btn) {
                btn.disabled = true;
                btn.textContent = btn.dataset.loadingText || 'Sending Link...';
            }
        });
    </script>
</body>
</html>
