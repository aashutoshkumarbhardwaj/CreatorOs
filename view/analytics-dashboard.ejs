<%- include('partials/layout/header', {
    activeNav: 'analytics',
    title: 'Analytics Dashboard',
    
    
    extraHead: '<link rel="stylesheet" href="/css/analytics.css">'
}) %>

            <section class="content">
                <!-- Dashboard Head -->
                <div class="dashboard-head" style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem;">
                    <div>
                        <h1>Analytics Overview</h1>
                        <p>Track your audience growth and content performance.</p>
                    </div>
                    <% if (typeof creators !== 'undefined' && creators.length > 1) { %>
                    <div>
                        <select id="accountSelector" class="badge-retro" style="cursor:pointer; border:2px solid var(--black); background:var(--white); padding:0.5rem; font-family:'Space Grotesk', monospace; font-size:0.9rem;">
                            <% creators.forEach(creator => { %>
                                <option value="<%= creator._id %>" <%= creator._id.toString() === selectedCreatorId ? 'selected' : '' %>>
                                    <%= creator.username %> (<%= creator.platform %>)
                                </option>
                            <% }) %>
                        </select>
                    </div>
                    <% } %>
                    <div>
                        <button id="refreshStatsBtn" class="btn-retro" style="background:var(--accent-yellow); border:2px solid var(--black); box-shadow: 3px 3px 0 var(--black); cursor:pointer; font-weight:700; padding:0.5rem 1rem;">🔄 Refresh Stats</button>
                    </div>
                </div>



                <div class="analytics-grid" style="margin-top: 1.5rem;">
                    <!-- Analytics Graph -->
                    <section class="panel-retro">
                        <div class="panel-retro-title-row">
                            <h2>Audience Growth</h2>
                            <select id="timeRangeSelect" class="badge-retro" style="cursor:pointer; border:2px solid var(--black); background:var(--white); padding:0.25rem; font-family:'Space Grotesk', monospace;">
                                <option value="7">Last 7 Days</option>
                                <option value="30" selected>Last 30 Days</option>
                                <option value="90">Last 90 Days</option>
                            </select>
                        </div>
                        <div class="chart-wrap" style="height:320px; position:relative;">
                            <canvas id="followersChart"></canvas>
                        </div>
                    </section>

                    <section class="panel-retro">
                        <div class="panel-retro-title-row">
                            <h2>Engagement Rate</h2>
                        </div>
                        <div class="chart-wrap" style="height:320px; position:relative;">
                            <canvas id="engagementChart"></canvas>
                        </div>
                    </section>
                </div>

                <!-- Top Posts -->
                <section class="panel-retro" style="margin-top: 1.5rem;">
                    <div class="panel-retro-title-row">
                        <h2>Top Performing Content</h2>
                        <span class="badge-retro">Recent</span>
                    </div>
                    <div class="table-panel-retro">
                        <div class="table-scroll">
                            <table class="recent-links-table">
                                <thead>
                                    <tr>
                                        <th>Title</th>
                                        <th>Type</th>
                                        <th>Date</th>
                                        <th>Likes</th>
                                        <th>Comments</th>
                                        <th>Engagement</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% if (analytics.topPosts && analytics.topPosts.length > 0) { %>
                                        <% analytics.topPosts.forEach(post => { %>
                                            <tr>
                                                <td style="font-weight: 700;"><%= post.title %></td>
                                                <td><span class="badge-retro" style="background:var(--accent-yellow);"><%= post.type %></span></td>
                                                <td><%= post.date %></td>
                                                <td><%= post.likes %></td>
                                                <td><%= post.comments %></td>
                                                <td class="short-url"><%= post.engagement %></td>
                                            </tr>
                                        <% }) %>
                                    <% } else { %>
                                        <tr>
                                            <td colspan="6" style="text-align:center; padding: 2rem; color: var(--muted);">No recent content to display. Click Refresh Stats to fetch latest posts.</td>
                                        </tr>
                                    <% } %>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </section>
            </section>
        

    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        const sidebarToggle = document.getElementById('sidebarToggle');
        const dashboardLayout = document.getElementById('dashboardLayout');
        

        if (sidebarToggle) {
            sidebarToggle.addEventListener('click', () => {
                dashboardLayout.classList.toggle('sidebar-collapsed');
            });
        }

        const themeBtn = document.getElementById('theme-toggle');
        const root = document.documentElement;
        const iconLight = themeBtn ? themeBtn.querySelector('.icon-light') : null;
        const iconDark = themeBtn ? themeBtn.querySelector('.icon-dark') : null;
        
        function applyTheme(isDark) {
            if (isDark) {
                root.setAttribute('data-theme', 'dark');
                if (iconLight) iconLight.style.display = 'none';
                if (iconDark) iconDark.style.display = 'block';
            } else {
                root.removeAttribute('data-theme');
                if (iconLight) iconLight.style.display = 'block';
                if (iconDark) iconDark.style.display = 'none';
            }
        }

        if (themeBtn) {
            if (localStorage.getItem('theme') === 'dark') {
                applyTheme(true);
            } else {
                applyTheme(false);
            }

            themeBtn.addEventListener('click', () => {
                const isDark = root.getAttribute('data-theme') === 'dark';
                applyTheme(!isDark);
                localStorage.setItem('theme', !isDark ? 'dark' : 'light');
                window.dispatchEvent(new Event('themeChanged'));
            });
        }

        // Chart.js Setup
        const chartGrid = getComputedStyle(document.documentElement).getPropertyValue('--chart-grid-color') || 'rgba(0,0,0,0.1)';
        const textColor = getComputedStyle(document.documentElement).getPropertyValue('--text') || '#111';
        const accentTeal = '#37D6C8';
        const accentBlue = '#76A9FA';
        
        Chart.defaults.color = textColor;
        Chart.defaults.font.family = "'Space Grotesk', monospace";

        const followersCtx = document.getElementById('followersChart');
        if (followersCtx) {
            window.followersChart = new Chart(followersCtx, {
                type: 'line',
                data: {
                    labels: <%- JSON.stringify(analytics.charts.labels) %>,
                    datasets: [{
                        label: 'Followers',
                        data: <%- JSON.stringify(analytics.charts.followers) %>,
                        borderColor: accentTeal,
                        backgroundColor: 'rgba(55, 214, 200, 0.1)',
                        borderWidth: 3,
                        pointBackgroundColor: accentTeal,
                        pointBorderColor: getComputedStyle(document.documentElement).getPropertyValue('--text').trim() || '#111',
                        pointBorderWidth: 2,
                        pointRadius: 5,
                        fill: true,
                        tension: 0.1
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: { legend: { display: false } },
                    scales: {
                        x: { grid: { color: chartGrid, drawBorder: false } },
                        y: { grid: { color: chartGrid, drawBorder: false } }
                    }
                }
            });
        }

        const engagementCtx = document.getElementById('engagementChart');
        if (engagementCtx) {
            window.engagementChart = new Chart(engagementCtx, {
                type: 'line',
                data: {
                    labels: <%- JSON.stringify(analytics.charts.labels) %>,
                    datasets: [{
                        label: 'Engagement (%)',
                        data: <%- JSON.stringify(analytics.charts.engagement) %>,
                        borderColor: accentBlue,
                        backgroundColor: 'rgba(118, 169, 250, 0.1)',
                        borderWidth: 3,
                        pointBackgroundColor: accentBlue,
                        pointBorderColor: getComputedStyle(document.documentElement).getPropertyValue('--text').trim() || '#111',
                        pointBorderWidth: 2,
                        pointRadius: 5,
                        fill: true,
                        tension: 0.1
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: { legend: { display: false } },
                    scales: {
                        x: { grid: { color: chartGrid, drawBorder: false } },
                        y: { grid: { color: chartGrid, drawBorder: false } }
                    }
                }
            });
        }
    </script>
    <script>
        const accountSelector = document.getElementById('accountSelector');
        if (accountSelector) {
            accountSelector.addEventListener('change', function() {
                const creatorId = this.value;
                const url = new URL(window.location);
                url.searchParams.set('creatorId', creatorId);
                window.location.href = url.toString();
            });
        }
    </script>
    <script>
        window.addEventListener('themeChanged', () => {
            const newGrid = getComputedStyle(document.documentElement).getPropertyValue('--chart-grid-color').trim() || 'rgba(0,0,0,0.1)';
            const newText = getComputedStyle(document.documentElement).getPropertyValue('--text').trim() || '#111';
            
            Chart.defaults.color = newText;
            
            const charts = [window.followersChart, window.engagementChart, window.perfChart].filter(Boolean);
            charts.forEach(chart => {
                if (chart.options.scales.x) chart.options.scales.x.grid.color = newGrid;
                if (chart.options.scales.y) chart.options.scales.y.grid.color = newGrid;
                
                chart.data.datasets.forEach(dataset => {
                    if (dataset.pointBorderColor) dataset.pointBorderColor = newText;
                });
                
                chart.update();
            });
        });

        // Interactive time range filter
        const timeSelect = document.getElementById('timeRangeSelect');
        if (timeSelect && window.followersChart && window.engagementChart) {
            const fullLabels = <%- JSON.stringify(analytics.charts.labels || []) %>;
            const fullFollowers = <%- JSON.stringify(analytics.charts.followers || []) %>;
            const fullEngagement = <%- JSON.stringify(analytics.charts.engagement || []) %>;

            timeSelect.addEventListener('change', (e) => {
                const val = e.target.value;
                let sliceCount = 30;
                if (val === '7') sliceCount = 7;
                else if (val === '90') sliceCount = 90;
                else sliceCount = 30;

                const slicedLabels = fullLabels.slice(-sliceCount);
                const slicedFollowers = fullFollowers.slice(-sliceCount);
                const slicedEngagement = fullEngagement.slice(-sliceCount);

                window.followersChart.data.labels = slicedLabels;
                window.followersChart.data.datasets[0].data = slicedFollowers;
                window.followersChart.update();

                window.engagementChart.data.labels = slicedLabels;
                window.engagementChart.data.datasets[0].data = slicedEngagement;
                window.engagementChart.update();
            });
        }

        // Refresh stats button with toast notification
        const refreshBtn = document.getElementById('refreshStatsBtn');
        if (refreshBtn) {
            refreshBtn.addEventListener('click', async () => {
                refreshBtn.disabled = true;
                refreshBtn.innerHTML = '⌛ Refreshing...';
                try {
                    await new Promise(r => setTimeout(r, 600));
                    showAnalyticsToast('Analytics refreshed successfully! 📈');
                    setTimeout(() => window.location.reload(), 1000);
                } catch (err) {
                    showAnalyticsToast('Failed to refresh analytics.', true);
                    refreshBtn.disabled = false;
                    refreshBtn.innerHTML = '🔄 Refresh Stats';
                }
            });
        }

        function showAnalyticsToast(msg, isErr = false) {
            let t = document.getElementById('analytics-toast');
            if (!t) {
                t = document.createElement('div');
                t.id = 'analytics-toast';
                t.style.cssText = 'position:fixed; bottom:24px; right:24px; padding:12px 20px; border:2px solid #111; box-shadow:4px 4px 0 #111; z-index:9999; font-family:"Space Grotesk",monospace; font-weight:700; transition:all 0.3s ease;';
                document.body.appendChild(t);
            }
            t.style.background = isErr ? '#E13B3B' : '#2BB673';
            t.style.color = isErr ? '#fff' : '#111';
            t.textContent = msg;
            t.style.display = 'block';
            setTimeout(() => { t.style.display = 'none'; }, 3000);
        }
    </script>

<%- include('partials/layout/footer') %>
