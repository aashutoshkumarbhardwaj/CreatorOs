<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Password Required</title>
  <style nonce="<%= nonce %>">
    body { font-family: 'Space Grotesk', sans-serif; background: #F5F1EA; display: flex; align-items: center; justify-content: center; min-height: 100vh; margin: 0; }
    .box { background: #fff; border: 2px solid #111; box-shadow: 5px 5px 0px #111; padding: 2rem; width: 90%; max-width: 380px; text-align: center; }
    h1 { font-size: 1.2rem; margin-bottom: 0.5rem; }
    p { font-size: 0.85rem; color: #555; margin-bottom: 1.5rem; }
    input { width: 100%; box-sizing: border-box; padding: 0.65rem 0.85rem; border: 2px solid #111; font-size: 0.9rem; margin-bottom: 1rem; }
    button { width: 100%; padding: 0.65rem; border: 2px solid #111; background: #37D6C8; font-weight: 700; cursor: pointer; box-shadow: 3px 3px 0px #111; }
    .error { color: #E13B3B; font-size: 0.8rem; margin-bottom: 1rem; font-weight: 700; }
  </style>
</head>
<body>
  <div class="box">
    <h1>🔒 This link is password protected</h1>
    <p>Enter the password to continue.</p>
    <% if (error) { %><div class="error"><%= error %></div><% } %>
    <form method="POST" action="/u/<%= shortId %>">
      <input type="password" name="password" placeholder="Password" autofocus required />
      <button type="submit">Continue</button>
    </form>
  </div>
</body>
</html>