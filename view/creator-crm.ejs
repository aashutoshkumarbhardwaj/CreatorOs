<!DOCTYPE html>
<html lang="en">
<head>

  <!-- SEO meta tags -->
  <%- include('./partials/_seo', {
    title: 'Creator CRM',
    description: 'Manage creator relationships and workflows.',
    canonical: 'https://titli-link-shortner.vercel.app/creator-crm',
    robots: 'noindex,nofollow'
  }) %>
  
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="icon" type="image/x-icon" href="/favicon.ico" />
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
  <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
<div class="layout">

  <!-- SIDEBAR -->
  <aside class="sidebar">
    <div class="brand">
      <h1>CreatorOS</h1>
      
    </div>

    <a href="/dashboard" class="nav-item">
      <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/></svg>
      Dashboard
    </a>
     <a class="nav-link" href="/vault">
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
    <polyline points="16 16 12 12 8 16"/>
    <line x1="12" y1="12" x2="12" y2="21"/>
    <path d="M20.39 18.39A5 5 0 0 0 18 9h-1.26A8 8 0 1 0 3 16.3"/>
  </svg>
  <span class="nav-text">Vault</span>
</a>
     
    <a href="/links" class="nav-item">
      <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>
      My Links
    </a>
    <a href="/analytics" class="nav-item">
      <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>
      Analytics
    </a>
    <a href="/services/creator-crm" class="nav-item active">
      <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
      CRM
    </a>
    
    <a href="/settings" class="nav-item">
      <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 1 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06A1.65 1.65 0 0 0 4.68 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 1 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06A1.65 1.65 0 0 0 9 4.68a1.65 1.65 0 0 0 1-1.51V3a2 2 0 1 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06A1.65 1.65 0 0 0 19.4 9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 1 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg>
      Settings
    </a>

    <div class="sidebar-spacer"></div>

    <button class="upgrade-btn">Upgrade Plan</button>

    <div class="sidebar-footer">
      <a href="/support" class="nav-item">
        <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
        Support
      </a>
      <a href="/logout" class="nav-item">
        <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
        Log Out
      </a>
    </div>
  </aside>

  <!-- MAIN -->
  <div class="main">

    <!-- TOPBAR -->
    <div class="topbar">
      <div class="search-wrap">
        <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
        <input class="search-input" type="text" placeholder="Search brands..." />
      </div>
      <div class="topbar-actions">
        <button class="new-project-btn">New Project</button>
        <button class="icon-btn">
          <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 0 1-3.46 0"/></svg>
        </button>
        <button class="icon-btn">
          <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
        </button>
        <button class="icon-btn">
          <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
        </button>
      </div>
    </div>

    <!-- CONTENT -->
    <div class="content">

      <!-- PIPELINE -->
      <div class="pipeline">

        <!-- LEADS -->
        <div class="pipeline-col">
          <div class="col-header">
            <span class="col-title">Leads (4)</span>
            <button class="col-header-action">
              <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="5" r="1"/><circle cx="12" cy="12" r="1"/><circle cx="12" cy="19" r="1"/></svg>
            </button>
          </div>
          <div class="col-body">
            <!-- Card 1 -->
            <div class="deal-card">
              <div class="deal-top">
                <span class="category-tag tag-tech">TECH</span>
                <span class="deal-amount">$5,000</span>
              </div>
              <div class="deal-name">Adobe Creative Cloud</div>
              <div class="deal-sub">Summer Campaign Intro</div>
              <div class="deal-footer">
                <div class="contact-row">
                  <div class="contact-avatar">SK</div>
                  <span class="contact-name">Sarah Miller</span>
                </div>
              </div>
            </div>

            <!-- Card 2 -->
            <div class="deal-card">
              <div class="deal-top">
                <span class="category-tag tag-gaming">GAMING</span>
                <span class="deal-amount">$2,200</span>
              </div>
              <div class="deal-name">Razer Global</div>
              <div class="deal-sub">BlackShark V2 Pro Review</div>
              <div class="deal-footer">
                <div class="contact-row">
                  <div class="contact-avatar" style="background: linear-gradient(135deg,#1e1e1e,#444); color:#fff;">JC</div>
                  <span class="contact-name">James Chen</span>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- OUTREACH -->
        <div class="pipeline-col">
          <div class="col-header">
            <span class="col-title">Outreach (2)</span>
            <button class="col-header-action">
              <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
            </button>
          </div>
          <div class="col-body">
            <!-- Card 3 -->
            <div class="deal-card" style="position:relative;">
              <span class="emailed-badge">Emailed</span>
              <div class="deal-top">
                <span class="category-tag tag-fintech">FINTECH</span>
                <span class="deal-amount" style="visibility:hidden;">$0</span>
              </div>
              <div class="deal-name">Revolut Business</div>
              <div class="deal-sub">Tax Season Partnership</div>
              <div class="deal-footer">
                <div class="contact-row">
                  <div class="contact-avatar" style="background: linear-gradient(135deg,#6ee7b7,#059669); color:#fff;">ER</div>
                  <span class="contact-name">Elena Ross</span>
                </div>
                <button class="deal-icon-btn">
                  <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                </button>
              </div>
            </div>
          </div>
        </div>

        <!-- NEGOTIATION -->
        <div class="pipeline-col">
          <div class="col-header">
            <span class="col-title">Negotiation (1)</span>
          </div>
          <div class="col-body">
            <!-- Card 4 - highlighted -->
            <div class="deal-card">
              <div class="deal-top">
                <span class="category-tag tag-lifestyle">LIFESTYLE</span>
                <span class="deal-amount">$8,500</span>
              </div>
              <div class="deal-name">Nespresso</div>
              <div class="deal-sub">Vertuo Pop Showcase · 3 Reels</div>
              <div class="deal-status-row">
                <div class="deal-status-tag">
                  <span class="check">
                    <svg fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg>
                  </span>
                  Counter-offer sent
                </div>
              </div>
              <div class="deal-footer">
                <div class="contact-row">
                  <div class="contact-avatar" style="background: linear-gradient(135deg,#c4b5fd,#7c3aed); color:#fff;">MT</div>
                  <span class="contact-name">Marcus Thorne</span>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div><!-- /pipeline -->

      <!-- BOTTOM STRIP -->
      <div class="bottom-strip">

        <!-- RECENT BRAND CONTACTS -->
        <div class="contacts-panel">
          <div class="panel-header">
            <span class="panel-title">Recent Brand Contacts</span>
            <a href="/services/creator-crm/all" class="view-all-link">View All CRM</a>
          </div>
          <table class="contacts-table">
            <thead>
              <tr>
                <th>Company</th>
                <th>Primary Contact</th>
                <th>Last Activity</th>
                <th>Status</th>
                <th>Actions</th>
              </tr>
            </thead>
            <tbody>
              <% if (typeof contacts !== 'undefined' && contacts.length > 0) { %>
                <% contacts.forEach(function(c) { %>
                  <tr>
                    <td class="contact-company"><%= c.company %></td>
                    <td><%= c.contact %></td>
                    <td><%= c.lastActivity %></td>
                    <td><span class="status-chip chip-<%= c.statusClass %>"><%= c.status %></span></td>
                    <td><span class="action-icon"><svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg></span></td>
                  </tr>
                <% }) %>
              <% } else { %>
                <tr>
                  <td class="contact-company">SquareSpace</td>
                  <td>David Hoffman</td>
                  <td>2 days ago</td>
                  <td><span class="status-chip chip-partner">Partner</span></td>
                  <td><span class="action-icon"><svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg></span></td>
                </tr>
                <tr>
                  <td class="contact-company">HelloFresh</td>
                  <td>Clara Vance</td>
                  <td>Yesterday</td>
                  <td><span class="status-chip chip-negotiating">Negotiating</span></td>
                  <td><span class="action-icon"><svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg></span></td>
                </tr>
                <tr>
                  <td class="contact-company">MasterClass</td>
                  <td>Benny G.</td>
                  <td>14h ago</td>
                  <td><span class="status-chip chip-active">Active</span></td>
                  <td><span class="action-icon"><svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg></span></td>
                </tr>
              <% } %>
            </tbody>
          </table>
        </div>

        <!-- INVOICED & UNPAID -->
        <div class="invoiced-panel">
          <div class="invoiced-header">
            <span class="panel-title">Invoiced &amp; Unpaid</span>
          </div>
          <div class="invoiced-body">
            <div class="invoiced-amount">
              <span class="big-num">$<%= typeof totalUnpaid !== 'undefined' ? totalUnpaid.toLocaleString() : '32,450' %></span>
              <span class="pending-label">Pending</span>
            </div>
            <div class="invoice-list">
              <% if (typeof invoices !== 'undefined' && invoices.length > 0) { %>
                <% invoices.forEach(function(inv) { %>
                  <div class="invoice-item">
                    <div class="invoice-info">
                      <div class="invoice-name"><%= inv.name %></div>
                      <div class="invoice-due <%= inv.overdue ? 'overdue' : 'due-in' %>">
                        <%= inv.overdue ? 'OVERDUE ' + inv.dueLabel : 'DUE IN ' + inv.dueLabel %>
                      </div>
                    </div>
                    <div class="invoice-amount">$<%= inv.amount.toLocaleString() %></div>
                  </div>
                <% }) %>
              <% } else { %>
                <div class="invoice-item">
                  <div class="invoice-info">
                    <div class="invoice-name">Skillshare · Annual</div>
                    <div class="invoice-due overdue">OVERDUE 4D</div>
                  </div>
                  <div class="invoice-amount">$12,000</div>
                </div>
                <div class="invoice-item">
                  <div class="invoice-info">
                    <div class="invoice-name">NordVPN · Mar</div>
                    <div class="invoice-due due-in">DUE IN 12D</div>
                  </div>
                  <div class="invoice-amount"></div>
                </div>
              <% } %>
            </div>
            <button class="add-invoice-btn">+</button>
          </div>
        </div>

      </div><!-- /bottom-strip -->

    </div><!-- /content -->
  </div><!-- /main -->

</div><!-- /layout -->
</body>
</html>