<!DOCTYPE html>
<html lang="en">

<head>

    <!-- SEO meta tags -->
    <%- include('./partials/_seo', {
        title: 'My Links',
        description: 'Manage your links.',
        canonical: 'https://titli-link-shortner.vercel.app/my-links',
        robots: 'noindex,nofollow'
    }) %>
    
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    
    <!-- Import Google Fonts: Space Grotesk and Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700&family=Space+Grotesk:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">
</head>
<body class="workspace-page links-page" data-user='<%- JSON.stringify({ name: user.name, initials: user.initials, isGuestContributor: isGuestContributor }) %>' data-domain="<%= domain %>">
    <div class="dashboard-layout" id="dashboardLayout">
        
        <!-- Sidebar -->
        <aside class="sidebar" id="sidebar" aria-label="Dashboard navigation">
            <a class="brand" href="/dashboard">
                <span class="brand-mark">CO</span>
                <div>
                    <span class="brand-text">CreatorOS</span>
                    <span class="brand-version">v2.0 Beta</span>
                </div>
            </a>
            
            <button id="theme-toggle" class="theme-btn" type="button" aria-label="Toggle Theme">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" style="width:18px;height:18px;margin:auto;"><circle cx="12" cy="12" r="5"></circle><path d="M12 1v2M12 21v2M4.2 4.2l1.4 1.4M18.4 18.4l1.4 1.4M1 12h2M21 12h2M4.2 19.8l1.4-1.4M18.4 5.6l1.4-1.4"></path></svg>
            </button>

            <!-- Workspace section -->
            <nav class="sidebar-section">
                <p class="sidebar-label">Workspace</p>
                <a class="nav-link" href="/dashboard">
                    <svg viewBox="0 0 24 24"><rect x="3" y="3" width="7" height="7"></rect><rect x="14" y="3" width="7" height="7"></rect><rect x="14" y="14" width="7" height="7"></rect><rect x="3" y="14" width="7" height="7"></rect></svg>
                    <span class="nav-text">Dashboard</span>
                </a>
                <a class="nav-link active" href="/services/url-shortener">
                    <svg viewBox="0 0 24 24"><path d="M10 13a5 5 0 0 0 7.07 0l2.83-2.83a5 5 0 0 0-7.07-7.07L11 4.9"></path><path d="M14 11a5 5 0 0 0-7.07 0L4.1 13.83a5 5 0 0 0 7.07 7.07L13 19.1"></path></svg>
                    <span class="nav-text">My Links</span>
                </a>
                <a class="nav-link" href="/services/analytics-dashboard">
                    <svg viewBox="0 0 24 24"><path d="M4 19V5"></path><path d="M9 19V9"></path><path d="M14 19V3"></path><path d="M19 19v-7"></path></svg>
                    <span class="nav-text">Analytics</span>
                </a>
                <a class="nav-link" href="/settings">
                    <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="3"></circle><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1-2.83 2.83l-.06-.06A1.65 1.65 0 0 0 15 19.4a1.65 1.65 0 0 0-1 .6V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 20.4a1.65 1.65 0 0 0-1.82-.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06A1.65 1.65 0 0 0 4.6 15H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06A1.65 1.65 0 0 0 9 4.6V3a2 2 0 0 1 4 0v.09A1.65 1.65 0 0 0 15 3.6l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06A1.65 1.65 0 0 0 19.4 9H21a2 2 0 0 1 0 4h-.09A1.65 1.65 0 0 0 19.4 15Z"></path></svg>
                    <span class="nav-text">Settings</span>
                </a>
            </nav>

            <!-- Services section -->
             
            <nav class="sidebar-section" aria-label="Services">
                <p class="sidebar-label">Services</p>

<a class="service-link" href="/services/bio-builder">
    <svg viewBox="0 0 24 24">
        <path d="M12 3v18"></path>
        <path d="M3 12h18"></path>
    </svg>

    <span class="service-name">
        Smart Bio Builder
    </span>
</a>

                <% services.forEach((service) => { %>
                    <a class="service-link <%= service.status %>" href="<%= service.route %>" title="<%= service.name %>">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><%- service.svgPath || '<path d="M12 3v18"></path><path d="M3 12h18"></path>' %></svg>
                        <span class="service-name"><%= service.name %></span>
                    </a>
                <% }) %>
            </nav>

            <div class="sidebar-footer" style="margin-top: auto;">
                <div class="upgrade-box">
                    <h4>Upgrade Plan</h4>
                    <p style="font-size: 0.9rem;">Get access to advanced webhooks & APIs.</p>
                    <button class="upgrade-btn" type="button">Upgrade</button>
                </div>
                <a class="nav-link" href="/logout">
                    <svg viewBox="0 0 24 24"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4M16 17l5-5-5-5M21 12H9"></path></svg>
                    <span class="nav-text">Logout</span>
                </a>
            </div>
        </aside>

        <!-- Main Workspace Panel -->
        <main class="main">
            <!-- Topbar -->
            <header class="topbar">
                <button class="menu-btn" type="button" aria-label="Toggle sidebar" id="sidebarToggle">
                    <svg viewBox="0 0 24 24"><path d="M3 12h18M3 6h18M3 18h18"></path></svg>
                </button>

                <div class="search-container">
                    <svg class="search-icon" viewBox="0 0 24 24"><circle cx="11" cy="11" r="8"></circle><path d="m21 21-4.35-4.35"></path></svg>
                    <input type="text" id="search-links-input" placeholder="Search shortened links..." />
                </div>

                <div class="topbar-actions">
                    <button class="action-icon-btn" type="button"><svg viewBox="0 0 24 24"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9M13.73 21a2 2 0 0 1-3.46 0"></path></svg></button>
                    <a class="profile-chip" href="/profile">
                        <span class="avatar"><%= user.initials %></span>
                        <span class="profile-name"><%= user.name %></span>
                    </a>
                    <a class="primary-action-btn" href="/services/url-shortener">
                        <svg viewBox="0 0 24 24" style="width:1.25rem; height:1.25rem; stroke:currentColor; stroke-width:2.5; fill:none;"><path d="M12 5v14M5 12h14"></path></svg>
                        Create Link
                    </a>
                </div>
            </header>

            <section class="content">
                <!-- Dashboard Head -->
                <div class="dashboard-head">
                    <div>
                        <h1>Titli URL Shortener</h1>
                        <p>Shorten your long URLs with style and track their performance.</p>
                    </div>
                    <div class="topbar-actions">
                        <button type="button" class="primary-action-btn" id="scroll-shorten-btn" style="padding: 0.55rem 1.1rem; font-size: 0.9rem;">+ New Link</button>
                    </div>
                </div>

                <% if (isGuestContributor) { %>
                    <div class="message-box message-error" style="margin-bottom: 1.5rem;">
                        Contributor accounts can view links but cannot create new ones.
                    </div>
                <% } %>

           <div class="analytics-grid">
                    <!-- Main Links Feed -->
                    <div style="display:flex; flex-direction:column; gap:1.5rem;">
                        
                        <!-- Shorten Form -->
                        <section class="panel-retro accent-blue" id="shorten-section">
                            <div class="panel-retro-title-row">
                                <h2>Create Link</h2>
                                <span class="badge-retro">Fast</span>
                            </div>
                            
                            <form id="shorten-form" style="display:flex; flex-direction:column; gap:1rem;">
                                <div style="display:flex; gap:0.5rem; flex-wrap:wrap;">
                                    <input type="url" id="redirect-url" placeholder="Paste your long link here... https://" required <%= isGuestContributor ? 'disabled' : '' %> style="flex:1; border:2px solid var(--border); padding:0.75rem; font-size:0.9rem; outline:none; background:var(--card-bg); color:var(--text); box-shadow:inset 2px 2px 0px rgba(0,0,0,0.05);" />
                                    <button type="submit" id="shorten-btn" <%= isGuestContributor ? 'disabled' : '' %> style="background:var(--accent-yellow); border:2px solid var(--border); padding:0.75rem 1.5rem; font-weight:700; cursor:pointer; box-shadow:2px 2px 0px var(--border);">SHORTEN NOW</button>
                                </div>
                                
                                <div style="display:flex; justify-content:space-between; align-items:center; font-size:0.8rem;">
                                    <span>Default domain: <strong id="domain-label" style="font-weight:700;"><%= domain %>/</strong></span>
                                    <button type="button" id="slug-toggle" style="background:none; border:none; text-decoration:underline; cursor:pointer; font-weight:700; color:var(--text);">Edit slug & tag</button>
                                </div>

                                <div id="slug-panel" style="display:none; flex-direction:column; gap:1rem; padding:1rem; border:2px solid var(--border); background:var(--bg-secondary); margin-top:0.5rem;">
                                    <div style="display:flex; flex-direction:column; gap:0.25rem;">
                                        <label for="custom-slug" style="font-size:0.75rem; font-weight:700; text-transform:uppercase;">Custom slug (optional)</label>
                                        <input type="text" id="custom-slug" placeholder="summer24" pattern="[a-zA-Z0-9-_]{3,32}" maxlength="32" style="border:2px solid var(--border); padding:0.5rem; background:var(--card-bg); color:var(--text);">
                                    </div>
                                    <div style="display:flex; flex-direction:column; gap:0.25rem;">
                                        <label for="link-title" style="font-size:0.75rem; font-weight:700; text-transform:uppercase;">Title (optional)</label>
                                        <input type="text" id="link-title" placeholder="Summer Campaign 2024" style="border:2px solid var(--border); padding:0.5rem; background:var(--card-bg); color:var(--text);">
                                    </div>
                                    <div style="display:flex; flex-direction:column; gap:0.25rem;">
                                        <label for="link-tag" style="font-size:0.75rem; font-weight:700; text-transform:uppercase;">Tag</label>
                                        <select id="link-tag" style="border:2px solid var(--border); padding:0.5rem; background:var(--card-bg); color:var(--text);">
                                            <option value="active">Active</option>
                                            <option value="social">Social</option>
                                            <option value="campaign">Campaign</option>
                                            <option value="general">General</option>
                                        </select>
                                    </div>
                                </div>
                                
                                    

                                <div id="result-banner" style="display:none; justify-content:space-between; align-items:center; background:var(--success); color:var(--text); padding:0.75rem 1rem; border:2px solid var(--border); box-shadow:2px 2px 0px var(--border); font-weight:700; margin-top:0.5rem;">
                                    <span id="result-text"></span>
                                    <button type="button" id="copy-result-btn" style="background:var(--card-bg); color:var(--text); border:2px solid var(--border); padding:0.35rem 0.75rem; cursor:pointer; font-weight:700; font-size:0.8rem;">Copy</button>
                                </div>
                            </form>
                        </section>

                        <!-- Recent Links -->
                        <section class="panel-retro">
                            <div class="panel-retro-title-row">
                                <h2>Recent Shortlinks</h2>
                                <div style="display:flex; gap:0.5rem;">
                                    <button type="button" id="sort-date" class="badge-retro" style="cursor:pointer;" title="Sort by date">Date</button>
                                    <button type="button" id="sort-clicks" class="badge-retro" style="cursor:pointer; background:var(--bg-secondary);" title="Sort by clicks">Clicks</button>
                                </div>
                            </div>
                            
                            <div id="links-feed" style="display:flex; flex-direction:column; gap:1rem;">
                                <div class="empty-state" id="empty-state" style="padding:2rem; text-align:center; border:2px dashed var(--border); color:var(--muted-2);">
                                    <h4 style="font-family:'Space Grotesk',sans-serif; font-size:1.1rem; margin-bottom:0.5rem;">No links yet</h4>
                                    <p style="font-size:0.85rem;">Paste a URL above and hit SHORTEN NOW to create your first link.</p>
                                </div>
                            </div>
                        </section>
                    
                    </div>

                    <!-- Sidebar Widgets -->
                    <aside style="display:flex; flex-direction:column; gap:1.5rem;">
                        <article class="stat-card-retro">
                            <span class="card-id">WIDGET_01</span>
                            <span class="label">Link Vault</span>
                            <span class="value" id="stat-total-links">0</span>
                            <span class="subtext">Total shortlinks created</span>
                            <button type="button" id="widget-new-btn" style="margin-top:1rem; width:100%; background:var(--accent-teal); border:2px solid var(--border); padding:0.5rem; font-weight:700; cursor:pointer; box-shadow:2px 2px 0px var(--border); color:var(--text);">Create Link</button>
                        </article>

                        <article class="stat-card-retro accent-blue">
                            <span class="card-id">WIDGET_02</span>
                            <span class="label">Traffic Pulse</span>
                            <span class="value"><span id="stat-total-clicks">0</span></span>
                            <span class="subtext">Total Clicks</span>
                            
                            <div style="margin-top:1rem; border-top:2px solid #333; padding-top:0.75rem; font-size:0.8rem; color:#333;">
                                <p style="margin-bottom:0.5rem; font-weight:600;">Top Performer:</p>
                                <p id="stat-top-link" style="font-weight:700; word-break:break-all;">—</p>
                            </div>
                            
                           
                        </article>
              </aside>

</div>



</main>

<footer style="margin-top:3rem; padding-top:1.5rem; border-top:var(--border-thick); display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:1rem; font-size:0.8rem; color:var(--muted-2);">
                    <span>© <%= new Date().getFullYear() %> CreatorOS Ecosystem · Titli Module v1.2.4</span>
                    <div style="display:flex; gap:1.5rem;">
                        <a href="/services/url-shortener" style="font-weight:700;">API Docs</a>
                        <a href="/settings" style="font-weight:700;">Webhooks</a>
                        <a href="/" style="font-weight:700;">Terms</a>
                    </div>
                </footer>
            
        

    
    </div>
    
    <div class="toast" id="toast" role="status" aria-live="polite" style="display:none; position:fixed; bottom:20px; right:20px; background:var(--card-bg); border:var(--border-thick); padding:1rem; box-shadow:var(--shadow-retro); z-index:1000; font-weight:700;"></div>

    <script src="/js/pages/my-links.js"></script>
    <script>
        const sidebarToggle = document.getElementById('sidebarToggle');
        const dashboardLayout = document.getElementById('dashboardLayout');
        const themeToggle = document.getElementById('theme-toggle');

        if (sidebarToggle && dashboardLayout) {
            sidebarToggle.addEventListener('click', () => {
                dashboardLayout.classList.toggle('sidebar-collapsed');
            });
        }

        if (themeToggle) {
            themeToggle.addEventListener('click', () => {
                document.body.classList.toggle('dark-mode');
            });
        }
        
        // Setup Search functionality
        const searchInput = document.getElementById('search-links-input');
        const oldSearch = document.getElementById('link-search'); // used by my-links.js
        if(searchInput) {
            searchInput.id = 'link-search'; // give it the ID expected by the JS
        }
    </script>
</body>
</html>


