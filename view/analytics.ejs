    title: 'Analytics',
    description: 'Creator analytics dashboard.',
    canonical: 'https://titli-link-shortner.vercel.app/analytics',
    robots: 'noindex,nofollow'
  }) %>
  
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="icon" type="image/x-icon" href="/favicon.ico" />
  <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
  <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
  
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
<div class="layout">

  <!-- SIDEBAR -->
  <aside class="sidebar">
    <div class="brand">
      <h1>CreatorOS</h1>
      <span class="beta">v2.0 Beta</span>
    </div>

    <nav>
      <a href="/dashboard" class="nav-item">
        <svg viewBox="0 0 24 24"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/></svg>
        Dashboard
      </a>
      <a href="/services/url-shortener" class="nav-item">
        <svg viewBox="0 0 24 24"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>
        My Links
      </a>
      <a href="/services/analytics-dashboard" class="nav-item active">
        <svg viewBox="0 0 24 24"><path d="M4 19V5"/><path d="M9 19V9"/><path d="M14 19V3"/><path d="M19 19v-7"/></svg>
        Analytics
      </a>
      <a href="/services/creator-crm" class="nav-item">
        <svg viewBox="0 0 24 24"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
        CRM
      </a>
      <a href="/settings" class="nav-item">
        <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 1 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06A1.65 1.65 0 0 0 4.68 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 1 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06A1.65 1.65 0 0 0 9 4.68a1.65 1.65 0 0 0 1-1.51V3a2 2 0 1 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06A1.65 1.65 0 0 0 19.4 9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 1 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg>
        Settings
      </a>
    </nav>

    <div class="sidebar-spacer"></div>

    <div class="upgrade-box">
      <button>Upgrade Plan</button>
    </div>

    <a href="/support" class="nav-item">
      <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
      Support
    </a>
    <a href="/logout" class="nav-item">
      <svg viewBox="0 0 24 24"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
      Log Out
    </a>
  </aside>

  <!-- MAIN -->
  <div class="main">

    <!-- TOPBAR -->
    <header class="topbar">
      <h2>Analytics</h2>
      <div class="search-wrap">
        <svg viewBox="0 0 24 24"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
        <input class="search-input" type="text" placeholder="Search analytics data..." />
      </div>
      <div class="topbar-actions">
        <button class="icon-btn">
          <svg viewBox="0 0 24 24"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 0 1-3.46 0"/></svg>
        </button>
        <button class="icon-btn">
          <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
        </button>
        <button class="icon-btn">
          <svg viewBox="0 0 24 24"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
        </button>
        <button class="export-btn">Export Data</button>
      </div>
    </header>

    <!-- CONTENT -->
    <section class="content">

      <!-- STAT CARDS -->
      <div class="stats-row">
        <div class="stat-card">
          <span class="stat-tag">TOTAL_VIEWS</span>
          <div class="stat-label">Total Views</div>
          <div class="stat-value">142.8k</div>
        </div>
        <div class="stat-card">
          <span class="stat-tag">CONV_RATE</span>
          <div class="stat-label">Conversion</div>
          <div class="stat-value">4.2%<span class="stat-delta delta-up">+0.8%</span></div>
        </div>
        <div class="stat-card">
          <span class="stat-tag">AVG_ENGAGEMENT</span>
          <div class="stat-label">Avg Time</div>
          <div class="stat-value">2:45<span class="stat-delta delta-down">-15s</span></div>
        </div>
        <div class="stat-card yellow">
          <span class="stat-tag">CLICK_THRU</span>
          <div class="stat-label">CTR</div>
          <div class="stat-value">18.5%<span class="stat-delta delta-up">+2.1%</span></div>
        </div>
      </div>

      <!-- MID: CHART + MODULES -->
      <div class="mid-section">

        <!-- Engagement Chart -->
        <div class="chart-panel">
          <div class="chart-panel-head">
            <div>
              <h2>Engagement Over<br>Time</h2>
              <p>Daily user interaction across all modules</p>
            </div>
            <div class="period-tabs">
              <button class="period-tab active" onclick="setPeriod(this,'7d')">7D</button>
              <button class="period-tab" onclick="setPeriod(this,'30d')">30D</button>
              <button class="period-tab" onclick="setPeriod(this,'90d')">90D</button>
            </div>
          </div>
          <div class="chart-wrap">
            <canvas id="engagementChart"></canvas>
          </div>
        </div>

        <!-- Top Modules -->
        <div class="modules-panel">
          <div class="modules-panel-head">
            <h2>Top Modules</h2>
            <span class="modules-trend">↗</span>
          </div>

          <div class="module-row">
            <div class="module-label-row"><span>Link Optimizer</span><span>84%</span></div>
            <div class="module-bar-bg"><div class="module-bar" style="width:84%"></div></div>
          </div>
          <div class="module-row">
            <div class="module-label-row"><span>Audience Insights</span><span>62%</span></div>
            <div class="module-bar-bg"><div class="module-bar" style="width:62%"></div></div>
          </div>
          <div class="module-row">
            <div class="module-label-row"><span>Revenue Track</span><span>45%</span></div>
            <div class="module-bar-bg"><div class="module-bar" style="width:45%"></div></div>
          </div>
          <div class="module-row">
            <div class="module-label-row"><span>Bio Builder</span><span>38%</span></div>
            <div class="module-bar-bg"><div class="module-bar" style="width:38%"></div></div>
          </div>

          <button class="view-full-btn">View Full Report</button>
        </div>
      </div>

      <!-- GLOBAL REACH -->
      <div class="reach-panel">
        <div class="reach-left">
          <h2>Global Reach</h2>
          <p>Where your audience is clicking from around the world.</p>

          <div class="country-row">
            <span class="country-name"><span class="country-dot" style="background:#37D6C8;"></span>United States</span>
            <span class="country-pct">42%</span>
          </div>
          <div class="country-row">
            <span class="country-name"><span class="country-dot" style="background:#4fb8c0;"></span>United Kingdom</span>
            <span class="country-pct">18%</span>
          </div>
          <div class="country-row">
            <span class="country-name"><span class="country-dot" style="background:#a8d8db;"></span>Germany</span>
            <span class="country-pct">12%</span>
          </div>
          <div class="country-row">
            <span class="country-name"><span class="country-dot" style="background:#b5882a;"></span>India</span>
            <span class="country-pct">9%</span>
          </div>
        </div>

        <div class="reach-map">
  <div id="map" style="width:100%; height:100%; min-height:280px;"></div>
</div>
          
      </div>

      <!-- REAL-TIME INSIGHTS -->
      <div class="insights-panel">
        <div class="insights-head">
          <h2>Real-Time Insights</h2>
        </div>
        <table class="insights-table">
          <thead>
            <tr>
              <th>Event</th>
              <th>Module</th>
              <th>Origin</th>
              <th>Time</th>
              <th>Status</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td><span class="event-link">Click: Newsletter_v2</span></td>
              <td>Link Optimizer</td>
              <td>Direct / Mobile</td>
              <td>2m ago</td>
              <td><span class="status-badge badge-success">Success</span></td>
            </tr>
            <tr>
              <td><span class="event-link">View: Instagram_Bio</span></td>
              <td>Bio Builder</td>
              <td>Social / Web</td>
              <td>5m ago</td>
              <td><span class="status-badge badge-success">Success</span></td>
            </tr>
            <tr>
              <td><span class="event-link">Purchase: Pro_Plan</span></td>
              <td>Revenue Track</td>
              <td>Referral / Web</td>
              <td>14m ago</td>
              <td><span class="status-badge badge-pending">Pending</span></td>
            </tr>
          </tbody>
        </table>
      </div>

    </section>
  </div>
</div>

<script>
  // Engagement bar chart
  const ctx = document.getElementById('engagementChart');
  const engagementData = {
    '7d': {
      labels: ['MON','TUE','WED','THU','FRI','SAT','SUN'],
      data: [320, 280, 350, 420, 390, 310, 360]
    },
    '30d': {
      labels: ['W1','W2','W3','W4'],
      data: [1200, 1450, 1300, 1600]
    },
    '90d': {
      labels: ['Jan','Feb','Mar'],
      data: [4200, 5100, 4800]
    }
  };

  let chart = new Chart(ctx, {
    type: 'bar',
    data: {
      labels: engagementData['7d'].labels,
      datasets: [{
        data: engagementData['7d'].data,
        backgroundColor: '#37D6C8',
        borderColor: '#111',
        borderWidth: 2,
        borderRadius: 0,
      }]
    },
    options: {
      responsive: true,
      maintainAspectRatio: false,
      plugins: { legend: { display: false } },
      scales: {
        x: {
          grid: { color: '#e2ddd6' },
          border: { color: '#111' },
          ticks: { font: { family: 'Space Grotesk', weight: '700' }, color: '#888' }
        },
        y: {
          grid: { color: '#e2ddd6' },
          border: { color: '#111' },
          ticks: { font: { family: 'Space Grotesk', weight: '700' }, color: '#888' }
        }
      }
    }
  });

  function setPeriod(btn, period) {
    document.querySelectorAll('.period-tab').forEach(b => b.classList.remove('active'));
    btn.classList.add('active');
    chart.data.labels = engagementData[period].labels;
    chart.data.datasets[0].data = engagementData[period].data;
    chart.update();
  }
  // Leaflet Map
const map = L.map('map', {
  zoomControl: false,
  scrollWheelZoom: false
}).setView([20, 0], 2);

L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
  attribution: '© OpenStreetMap'
}).addTo(map);

// Custom teal circle marker
function makeMarker(lat, lng, size, color, label, pct) {
  return L.circleMarker([lat, lng], {
    radius: size,
    fillColor: color,
    color: '#111',
    weight: 2,
    fillOpacity: 0.85
  }).addTo(map).bindPopup(`<b>${label}</b><br>${pct}`);
}

// Hardcoded points — swap with real user data later
makeMarker(37.09,  -95.71, 18, '#37D6C8', 'United States', '42%');
makeMarker(55.37,  -3.43,  12, '#4fb8c0', 'United Kingdom', '18%');
makeMarker(51.16,  10.45,  10, '#a8d8db', 'Germany',        '12%');
makeMarker(20.59,  78.96,   9, '#b5882a', 'India',           '9%');

L.control.zoom({ position: 'bottomright' }).addTo(map);
</script>

</body>
</html>