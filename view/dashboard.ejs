<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <title>Dashboard | CreatorOS</title>
    
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700;800&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
    
    <style>
        :root {
            --bg: #F5F1EA;
            --bg-secondary: #EDE8DF;
            --card-bg: #FFFFFF;
            --text: #111111;
            --border: #111111;
            --accent-teal: #37D6C8;
            --accent-blue: #76A9FA;
            --accent-yellow: #E4C13B;
            --accent-red: #E13B3B;
            --success: #2BB673;
            --muted: #3A3A3A;
            --muted-2: #5C5C5C;
            --white: #FFFFFF;
            --chart-grid-color: #DDD8CE;
            --chart-line-color: #37D6C8;
            --sidebar-width: 240px;
            --border-thick: 2px solid var(--border);
            --shadow-retro: 3px 3px 0px var(--border);
            --shadow-retro-hover: 5px 5px 0px var(--border);
            --shadow-retro-btn: 2px 2px 0px var(--border);
        }

        [data-theme="dark"] {
            --bg: #1A1A18;
            --bg-secondary: #252522;
            --card-bg: #2C2C28;
            --text: #F5F1EA;
            --border: #F5F1EA;
            --muted: #D1D5DB;
            --muted-2: #9CA3AF;
            --chart-grid-color: #3D3D39;
        }

        * { box-sizing: border-box; margin: 0; padding: 0; }

        body {
            font-family: 'Inter', sans-serif;
            color: var(--text);
            background-color: var(--bg);
            min-height: 100vh;
            overflow-x: hidden;
        }

        a { color: inherit; text-decoration: none; }

        h1, h2, h3, h4, .brand-text {
            font-family: 'Space Grotesk', sans-serif;
            font-weight: 700;
            color: var(--text);
        }

        .dashboard-layout {
            min-height: 100vh;
            display: grid;
            grid-template-columns: var(--sidebar-width) minmax(0, 1fr);
            transition: grid-template-columns 0.2s ease;
        }

        .dashboard-layout.sidebar-collapsed { --sidebar-width: 80px; }

        .sidebar {
            position: sticky;
            top: 0;
            height: 100vh;
            display: flex;
            flex-direction: column;
            background-color: var(--bg-secondary);
            border-right: var(--border-thick);
            padding: 1.5rem 1rem;
            overflow-y: auto;
            overflow-x: hidden;
        }

        .brand {
            display: flex;
            align-items: center;
            gap: 0.75rem;
            padding-bottom: 1.75rem;
            border-bottom: var(--border-thick);
            margin-bottom: 1.5rem;
        }

        .brand-mark {
            width: 2.2rem;
            height: 2.2rem;
            background-color: var(--accent-teal);
            border: var(--border-thick);
            display: grid;
            place-items: center;
            font-family: 'Space Grotesk', sans-serif;
            font-weight: 800;
            font-size: 1rem;
            box-shadow: var(--shadow-retro-btn);
            flex-shrink: 0;
            color: #111111;
        }

        .brand-text {
            font-size: 1.2rem;
            font-weight: 800;
            letter-spacing: -0.02em;
        }

        .brand-version {
            font-size: 0.65rem;
            font-family: 'Space Grotesk', sans-serif;
            font-weight: 600;
            color: var(--muted-2);
            text-transform: uppercase;
            letter-spacing: 0.08em;
            display: block;
            margin-top: 1px;
        }

        .sidebar-section {
            display: flex;
            flex-direction: column;
            gap: 0.3rem;
            margin-bottom: 2rem;
        }

        .sidebar-label {
            padding-left: 0.5rem;
            margin-bottom: 0.4rem;
            color: var(--muted-2);
            font-size: 0.65rem;
            font-family: 'Space Grotesk', sans-serif;
            font-weight: 700;
            letter-spacing: 0.1em;
            text-transform: uppercase;
        }

        .nav-link, .service-link {
            display: flex;
            align-items: center;
            gap: 0.75rem;
            padding: 0.7rem 0.85rem;
            border: 2px solid transparent;
            font-family: 'Space Grotesk', sans-serif;
            font-weight: 500;
            font-size: 0.9rem;
            transition: all 0.15s ease;
            cursor: pointer;
            color: var(--muted);
        }

        .nav-link:hover, .service-link:hover {
            background-color: rgba(0, 0, 0, 0.04);
            border-color: var(--border);
            color: var(--text);
        }

        [data-theme="dark"] .nav-link:hover,
        [data-theme="dark"] .service-link:hover {
            background-color: rgba(255,255,255,0.04);
        }

        .nav-link.active, .service-link.active {
            color: #111111;
            background-color: var(--accent-teal);
            border: var(--border-thick);
            box-shadow: var(--shadow-retro-btn);
            font-weight: 700;
        }

        .nav-icon {
            width: 1.2rem;
            height: 1.2rem;
            flex-shrink: 0;
            stroke: currentColor;
            fill: none;
        }

        .service-name { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

        .sidebar-footer {
            margin-top: auto;
            display: flex;
            flex-direction: column;
            gap: 0.75rem;
        }

        .upgrade-box {
            background-color: #111111;
            border: var(--border-thick);
            padding: 1rem 0.85rem;
            box-shadow: var(--shadow-retro-btn);
            display: flex;
            flex-direction: column;
            gap: 0.5rem;
            margin-bottom: 0.5rem;
        }

        .upgrade-box h4 {
            font-size: 0.95rem;
            font-family: 'Space Grotesk', sans-serif;
            font-weight: 700;
            color: #FFFFFF;
            line-height: 1.1;
        }

        .upgrade-box p {
            font-size: 0.78rem;
            color: rgba(255,255,255,0.65);
            line-height: 1.4;
        }

        .upgrade-btn {
            width: 100%;
            background-color: var(--accent-teal);
            border: 2px solid #FFFFFF;
            color: #111111;
            font-weight: 700;
            font-size: 0.8rem;
            padding: 0.4rem;
            text-align: center;
            box-shadow: 2px 2px 0px #FFFFFF;
            cursor: pointer;
            font-family: 'Space Grotesk', sans-serif;
        }
        .upgrade-btn:hover { transform: translate(-1px, -1px); }

        .dashboard-layout.sidebar-collapsed .brand-text,
        .dashboard-layout.sidebar-collapsed .brand-version,
        .dashboard-layout.sidebar-collapsed .sidebar-label,
        .dashboard-layout.sidebar-collapsed .service-name,
        .dashboard-layout.sidebar-collapsed .upgrade-box,
        .dashboard-layout.sidebar-collapsed .nav-text,
        .dashboard-layout.sidebar-collapsed #theme-toggle { display: none; }

        .dashboard-layout.sidebar-collapsed .brand { justify-content: center; padding-inline: 0; }

        .dashboard-layout.sidebar-collapsed .nav-link,
        .dashboard-layout.sidebar-collapsed .service-link {
            justify-content: center;
            padding: 0.75rem;
            font-size: 0;
        }

        .main { min-width: 0; display: flex; flex-direction: column; }

        .topbar {
            position: sticky;
            top: 0;
            z-index: 10;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 1.5rem;
            background-color: var(--bg);
            border-bottom: var(--border-thick);
            padding: 1rem 2rem;
        }

        .menu-btn, .icon-btn {
            width: 2.4rem;
            height: 2.4rem;
            display: grid;
            place-items: center;
            border: var(--border-thick);
            background-color: var(--card-bg);
            cursor: pointer;
            box-shadow: var(--shadow-retro-btn);
        }
        .menu-btn:hover, .icon-btn:hover { background-color: var(--bg-secondary); }

        .search-container {
            flex: 1;
            max-width: 480px;
            position: relative;
        }

        .search-input {
            width: 100%;
            border: var(--border-thick);
            background-color: var(--card-bg);
            color: var(--text);
            padding: 0.55rem 1rem 0.55rem 2.5rem;
            font-family: 'Inter', sans-serif;
            font-size: 0.9rem;
            outline: none;
        }
        .search-input:focus { box-shadow: var(--shadow-retro-btn); }
        .search-input::placeholder { color: var(--muted-2); }

        .search-icon {
            position: absolute;
            left: 0.85rem;
            top: 50%;
            transform: translateY(-50%);
            width: 1.1rem;
            height: 1.1rem;
            pointer-events: none;
            stroke: var(--muted-2);
            fill: none;
        }

        .topbar-actions { display: flex; align-items: center; gap: 0.75rem; }

        .action-icon-btn {
            width: 2.2rem;
            height: 2.2rem;
            display: grid;
            place-items: center;
            border: var(--border-thick);
            cursor: pointer;
            color: var(--text);
            background: var(--card-bg);
            box-shadow: var(--shadow-retro-btn);
        }
        .action-icon-btn:hover { background-color: var(--bg-secondary); }

        .profile-chip {
            display: inline-flex;
            align-items: center;
            gap: 0.65rem;
            border: var(--border-thick);
            background-color: var(--card-bg);
            color: var(--text);
            padding: 0.35rem 0.75rem;
            box-shadow: var(--shadow-retro-btn);
            cursor: pointer;
        }
        .profile-chip:hover { transform: translate(-1px, -1px); box-shadow: 3px 3px 0px var(--border); }

        .avatar {
            width: 1.6rem;
            height: 1.6rem;
            display: grid;
            place-items: center;
            background-color: var(--accent-teal);
            border: 1px solid var(--border);
            color: #111111;
            font-size: 0.72rem;
            font-weight: 700;
            font-family: 'Space Grotesk', sans-serif;
            flex-shrink: 0;
        }

        .profile-name {
            font-family: 'Space Grotesk', sans-serif;
            font-weight: 700;
            font-size: 0.85rem;
        }

        .primary-action-btn {
            background-color: var(--accent-teal);
            border: var(--border-thick);
            color: #111111;
            font-weight: 700;
            font-size: 0.9rem;
            padding: 0.55rem 1.1rem;
            font-family: 'Space Grotesk', sans-serif;
            box-shadow: var(--shadow-retro-btn);
            cursor: pointer;
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }
        .primary-action-btn:hover { transform: translate(-2px, -2px); box-shadow: var(--shadow-retro-hover); }
        .primary-action-btn:active { transform: translate(1px, 1px); box-shadow: 1px 1px 0px var(--border); }

        .content {
            padding: 2rem;
            display: flex;
            flex-direction: column;
            gap: 2rem;
        }

        .dashboard-head {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            flex-wrap: wrap;
            gap: 1rem;
            border-bottom: var(--border-thick);
            padding-bottom: 1.5rem;
        }

        .dashboard-head h1 {
            font-size: 2.5rem;
            line-height: 1.05;
            margin-bottom: 0.25rem;
            letter-spacing: -0.03em;
            font-weight: 800;
        }

        .dashboard-head p {
            font-size: 0.95rem;
            color: var(--muted-2);
        }

        .stats-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
            gap: 1.25rem;
        }

        .stat-card-retro {
            background-color: var(--card-bg);
            border: var(--border-thick);
            padding: 1.25rem 1.5rem;
            box-shadow: var(--shadow-retro);
            display: flex;
            flex-direction: column;
            position: relative;
            transition: transform 0.2s ease, box-shadow 0.2s ease;
        }
        .stat-card-retro:hover { transform: translate(-2px, -2px); box-shadow: var(--shadow-retro-hover); }

        .stat-card-retro.accent-blue { background-color: var(--accent-blue); color: #111111; }
        .stat-card-retro.accent-blue .label,
        .stat-card-retro.accent-blue .subtext,
        .stat-card-retro.accent-blue .card-id { color: #333333; }

        .stat-card-retro .card-id {
            position: absolute;
            right: 1.25rem;
            top: 1.25rem;
            font-size: 0.65rem;
            color: var(--muted-2);
            font-family: 'Space Grotesk', sans-serif;
            font-weight: 700;
            letter-spacing: 0.05em;
        }

        .stat-card-retro .label {
            font-size: 0.7rem;
            font-family: 'Space Grotesk', sans-serif;
            font-weight: 700;
            color: var(--muted-2);
            text-transform: uppercase;
            letter-spacing: 0.08em;
            margin-bottom: 0.5rem;
        }

        .stat-card-retro .value {
            font-size: 2.4rem;
            font-family: 'Space Grotesk', sans-serif;
            font-weight: 800;
            line-height: 1;
            margin-bottom: 0.25rem;
            letter-spacing: -0.02em;
        }

        .stat-card-retro .subtext {
            font-size: 0.78rem;
            color: var(--muted-2);
            font-weight: 500;
        }

        .trend { color: var(--success); font-weight: 700; }

        .panel-retro {
            background-color: var(--card-bg);
            border: var(--border-thick);
            padding: 1.5rem;
            box-shadow: var(--shadow-retro);
            display: flex;
            flex-direction: column;
            gap: 1.25rem;
        }

        .panel-retro-title-row {
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-bottom: var(--border-thick);
            padding-bottom: 0.75rem;
        }

        .panel-retro-title-row h2 { font-size: 1.2rem; letter-spacing: -0.01em; }

        .badge-retro {
            border: var(--border-thick);
            font-size: 0.65rem;
            font-family: 'Space Grotesk', sans-serif;
            font-weight: 700;
            padding: 0.2rem 0.55rem;
            background-color: var(--accent-teal);
            color: #111111;
            box-shadow: 1.5px 1.5px 0px var(--border);
            text-transform: uppercase;
            letter-spacing: 0.05em;
        }

        .status-grid-retro {
            display: grid;
            grid-template-columns: repeat(3, minmax(0, 1fr));
            gap: 1rem;
        }

        .status-card-retro {
            padding: 1rem;
            border: var(--border-thick);
            box-shadow: 2px 2px 0px var(--border);
            display: flex;
            flex-direction: column;
            gap: 0.25rem;
        }

        .status-card-retro h3 {
            font-size: 0.65rem;
            text-transform: uppercase;
            font-family: 'Space Grotesk', sans-serif;
            font-weight: 700;
            letter-spacing: 0.08em;
        }

        .status-card-retro p {
            font-size: 1.75rem;
            font-family: 'Space Grotesk', sans-serif;
            font-weight: 800;
            letter-spacing: -0.02em;
        }

        .status-card-retro.pending { background-color: var(--accent-yellow); color: #111111; }
        .status-card-retro.pending h3, .status-card-retro.pending p { color: #111111; }
        .status-card-retro.accepted { background-color: var(--success); color: #111111; }
        .status-card-retro.accepted h3, .status-card-retro.accepted p { color: #111111; }
        .status-card-retro.expired { background-color: var(--accent-red); color: #FFFFFF; }
        .status-card-retro.expired h3, .status-card-retro.expired p { color: #FFFFFF; }

        .analytics-grid {
            display: grid;
            grid-template-columns: 1.3fr 0.7fr;
            gap: 1.5rem;
        }

        .invite-form { display: flex; gap: 0.75rem; margin-top: 0.5rem; }

        .invite-form input {
            flex: 1;
            border: var(--border-thick);
            background-color: var(--bg);
            color: var(--text);
            padding: 0.65rem 0.85rem;
            font-family: 'Inter', sans-serif;
            font-size: 0.85rem;
            outline: none;
        }
        .invite-form input:focus { box-shadow: var(--shadow-retro-btn); }

        .invite-form button {
            background-color: #111111;
            border: var(--border-thick);
            color: #FFFFFF;
            font-family: 'Space Grotesk', sans-serif;
            font-weight: 700;
            font-size: 0.85rem;
            padding: 0.65rem 1.1rem;
            cursor: pointer;
            box-shadow: var(--shadow-retro-btn);
        }
        .invite-form button:hover {
            background-color: var(--accent-teal);
            color: #111111;
            transform: translate(-1px, -1px);
            box-shadow: 3px 3px 0px var(--border);
        }

        .message-box {
            padding: 0.75rem 1rem;
            border: var(--border-thick);
            font-size: 0.85rem;
            font-family: 'Space Grotesk', sans-serif;
            font-weight: 600;
            margin-top: 0.5rem;
        }
        .message-success { background-color: var(--success); color: #111111; }
        .message-error { background-color: var(--accent-red); color: #FFFFFF; }

        .chart-wrap {
            overflow: hidden;
            display: flex;
            flex-direction: column;
            border: var(--border-thick);
            background-color: var(--bg-secondary);
            padding: 0.75rem;
        }

        .table-scroll { width: 100%; overflow-x: auto; }

        .recent-links-table {
            width: 100%;
            border-collapse: collapse;
            text-align: left;
            min-width: 600px;
        }

        .recent-links-table th {
            background-color: var(--bg-secondary);
            border-bottom: var(--border-thick);
            padding: 0.75rem 1rem;
            font-family: 'Space Grotesk', sans-serif;
            font-size: 0.7rem;
            text-transform: uppercase;
            font-weight: 700;
            letter-spacing: 0.08em;
            color: var(--text);
        }

        .recent-links-table td {
            padding: 0.85rem 1rem;
            border-bottom: 1px solid var(--border);
            font-size: 0.85rem;
            color: var(--text);
            vertical-align: middle;
        }

        .recent-links-table tbody tr:last-child td { border-bottom: none; }
        .recent-links-table tbody tr:hover { background-color: rgba(55,214,200,0.05); }

        .short-url { color: var(--accent-teal); font-weight: 700; font-family: 'Space Grotesk', sans-serif; }

        .qr-badge {
            display: inline-flex;
            align-items: center;
            font-size: 0.7rem;
            font-family: 'Space Grotesk', sans-serif;
            font-weight: 700;
            padding: 0.2rem 0.55rem;
            background: var(--accent-teal);
            color: #111111;
            border: var(--border-thick);
            box-shadow: 1px 1px 0px var(--border);
        }

        .row-actions { display: flex; align-items: center; gap: 0.5rem; }

        .row-action {
            width: 1.8rem;
            height: 1.8rem;
            display: grid;
            place-items: center;
            border: var(--border-thick);
            background-color: var(--card-bg);
            color: var(--text);
            box-shadow: 1px 1px 0px var(--border);
            cursor: pointer;
        }
        .row-action:hover { background-color: var(--accent-teal); color: #111111; }

        svg {
            width: 1.15rem;
            height: 1.15rem;
            stroke-width: 2;
            fill: none;
            stroke: currentColor;
            display: inline-block;
            vertical-align: middle;
        }

        .qr-modal-wrap {
            display: none;
            position: fixed;
            inset: 0;
            z-index: 999;
            align-items: center;
            justify-content: center;
        }
        .qr-modal-wrap.open { display: flex; }

        .qr-backdrop {
            position: absolute;
            inset: 0;
            background: rgba(0,0,0,0.6);
        }

        .qr-modal {
            position: relative;
            z-index: 1;
            width: min(420px, 94vw);
            padding: 2rem;
            border: var(--border-thick);
            background: var(--card-bg);
            box-shadow: var(--shadow-retro-hover);
        }

        .qr-modal-head {
            display: flex;
            align-items: flex-start;
            justify-content: space-between;
            gap: 0.5rem;
            margin-bottom: 1.25rem;
        }
        .qr-modal-head h3 { font-family: 'Space Grotesk', sans-serif; font-size: 1.1rem; }
        .qr-modal-head p { font-size: 0.8rem; color: var(--muted-2); word-break: break-all; margin-top: 0.2rem; }

        .qr-close {
            width: 2rem;
            height: 2rem;
            display: grid;
            place-items: center;
            border: var(--border-thick);
            background: var(--bg-secondary);
            color: var(--text);
            cursor: pointer;
            flex-shrink: 0;
            box-shadow: var(--shadow-retro-btn);
        }
        .qr-close:hover { background-color: var(--accent-red); color: #FFFFFF; }

        .qr-preview {
            display: flex;
            align-items: center;
            justify-content: center;
            min-height: 200px;
            border: var(--border-thick);
            background: var(--bg-secondary);
            margin-bottom: 1.25rem;
        }
        .qr-preview img { width: 180px; height: 180px; display: block; }

        .qr-preview-placeholder {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 0.65rem;
            color: var(--muted-2);
            font-size: 0.88rem;
        }

        .qr-spinner {
            width: 2rem;
            height: 2rem;
            border: 3px solid rgba(55,214,200,0.2);
            border-top-color: var(--accent-teal);
            border-radius: 999px;
            animation: spin 0.8s linear infinite;
        }

        .qr-colors {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 0.85rem;
            margin-bottom: 1.2rem;
        }

        .qr-color-field label {
            display: block;
            font-size: 0.7rem;
            font-family: 'Space Grotesk', sans-serif;
            font-weight: 700;
            color: var(--muted-2);
            text-transform: uppercase;
            letter-spacing: 0.05em;
            margin-bottom: 0.35rem;
        }

        .qr-color-row {
            display: flex;
            align-items: center;
            gap: 0.55rem;
            border: var(--border-thick);
            padding: 0.4rem 0.75rem;
            background: var(--bg-secondary);
            box-shadow: var(--shadow-retro-btn);
        }

        .qr-color-row input[type="color"] {
            width: 1.5rem;
            height: 1.5rem;
            border: none;
            background: none;
            cursor: pointer;
            padding: 0;
        }

        .qr-color-row input[type="text"] {
            flex: 1;
            border: none;
            background: none;
            color: var(--text);
            font-family: 'Space Grotesk', sans-serif;
            font-size: 0.85rem;
            outline: none;
        }

        .qr-actions {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 0.75rem;
        }

        .qr-btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 0.5rem;
            padding: 0.8rem 1rem;
            font-family: 'Space Grotesk', sans-serif;
            font-weight: 700;
            font-size: 0.9rem;
            cursor: pointer;
            text-decoration: none;
            border: var(--border-thick);
            box-shadow: var(--shadow-retro-btn);
        }
        .qr-btn:hover { transform: translate(-1px, -1px); box-shadow: 3px 3px 0px var(--border); }
        .qr-btn svg { width: 1rem; height: 1rem; }

        .qr-btn-primary { color: #111111; background: var(--accent-teal); }
        .qr-btn-secondary { color: var(--text); background: var(--card-bg); }
        .qr-btn:disabled { opacity: 0.45; cursor: not-allowed; transform: none; }

        @keyframes spin { to { transform: rotate(360deg); } }

        @media (max-width: 1120px) {
            .stats-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
            .analytics-grid { grid-template-columns: 1fr; }
        }

        @media (max-width: 768px) {
            .dashboard-layout { grid-template-columns: 1fr; }
            .sidebar { display: none; }
            .topbar { padding: 1rem; }
            .content { padding: 1rem; }
            .status-grid-retro { grid-template-columns: 1fr; }
        }

        @media (max-width: 620px) {
            .stats-grid { grid-template-columns: 1fr; }
            .profile-name { display: none; }
            .qr-actions { grid-template-columns: 1fr; }
        }
    </style>
</head>
<body>
    <div class="dashboard-layout" id="dashboardLayout">

        <aside class="sidebar" id="sidebar" aria-label="Dashboard navigation">
            <a class="brand" href="/dashboard">
                <span class="brand-mark">CO</span>
                <div>
                    <span class="brand-text">CreatorOS</span>
                    <span class="brand-version">V2.0 Beta</span>
                </div>
            </a>

            <nav class="sidebar-section">
                <p class="sidebar-label">Workspace</p>
                <a class="nav-link active" href="/dashboard">
                    <svg viewBox="0 0 24 24"><rect x="3" y="3" width="7" height="7"></rect><rect x="14" y="3" width="7" height="7"></rect><rect x="14" y="14" width="7" height="7"></rect><rect x="3" y="14" width="7" height="7"></rect></svg>
                    <span class="nav-text">Dashboard</span>
                </a>
                <a class="nav-link" href="/services/url-shortener">
                    <svg viewBox="0 0 24 24"><path d="M10 13a5 5 0 0 0 7.07 0l2.83-2.83a5 5 0 0 0-7.07-7.07L11 4.9"></path><path d="M14 11a5 5 0 0 0-7.07 0L4.1 13.83a5 5 0 0 0 7.07 7.07L13 19.1"></path></svg>
                    <span class="nav-text">My Links</span>
                </a>
                <a class="nav-link" href="/services/analytics-dashboard">
                    <svg viewBox="0 0 24 24"><path d="M4 19V5"></path><path d="M9 19V9"></path><path d="M14 19V3"></path><path d="M19 19v-7"></path></svg>
                    <span class="nav-text">Analytics</span>
                </a>
                <a class="nav-link" href="/settings">
                    <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="3"></circle><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1-2.83 2.83l-.06-.06A1.65 1.65 0 0 0 15 19.4a1.65 1.65 0 0 0-1 .6V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 20.4a1.65 1.65 0 0 0-1.82-.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06A1.65 1.65 0 0 0 4.6 15H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06A1.65 1.65 0 0 0 9 4.6V3a2 2 0 0 1 4 0v.09A1.65 1.65 0 0 0 15 3.6l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06A1.65 1.65 0 0 0 19.4 9H21a2 2 0 0 1 0 4h-.09A1.65 1.65 0 0 0 19.4 15Z"></path></svg>
                    <span class="nav-text">Settings</span>
                </a>
            </nav>

            <nav class="sidebar-section" aria-label="Services">
                <p class="sidebar-label">Services</p>
                <% services.forEach((service) => { %>
                    <a class="service-link <%= service.status %>" href="<%= service.route %>" title="<%= service.name %>">
                        <svg viewBox="0 0 24 24"><path d="M12 3v18"></path><path d="M3 12h18"></path></svg>
                        <span class="service-name"><%= service.name %></span>
                    </a>
                <% }) %>
            </nav>

            <div class="sidebar-footer">
                <div class="upgrade-box">
                    <h4>Upgrade Plan</h4>
                    <p>Get access to advanced webhooks &amp; APIs.</p>
                    <button class="upgrade-btn" type="button">Upgrade</button>
                </div>
                <a class="nav-link" href="/logout">
                    <svg viewBox="0 0 24 24"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4M16 17l5-5-5-5M21 12H9"></path></svg>
                    <span class="nav-text">Logout</span>
                </a>
            </div>
        </aside>

        <main class="main">
            <header class="topbar">
                <button class="menu-btn" type="button" aria-label="Toggle sidebar" id="sidebarToggle">
                    <svg viewBox="0 0 24 24"><path d="M3 12h18M3 6h18M3 18h18"></path></svg>
                </button>

                <div class="search-container">
                    <svg class="search-icon" viewBox="0 0 24 24"><circle cx="11" cy="11" r="8"></circle><path d="m21 21-4.35-4.35"></path></svg>
                    <input type="text" id="search-links-input" class="search-input" placeholder="Search shortened links..." />
                </div>

                <div class="topbar-actions">
                    <button id="theme-toggle" class="action-icon-btn" type="button" aria-label="Toggle Theme">
                        <svg class="icon-light" width="20" height="20" viewBox="0 0 15 15" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M7.5 1.5V2.5M7.5 12.5V13.5M1.5 7.5H2.5M12.5 7.5H13.5M3.257 3.257L3.964 3.964M11.035 11.035L11.742 11.742M3.257 11.742L3.964 11.035M11.035 3.964L11.742 3.257" stroke="currentColor" stroke-width="1.5" stroke-linecap="square"/><circle cx="7.5" cy="7.5" r="2.75" stroke="currentColor" stroke-width="1.5"/></svg>
                        <svg class="icon-dark" width="20" height="20" viewBox="0 0 15 15" fill="none" xmlns="http://www.w3.org/2000/svg" style="display:none;"><path d="M1.66 7.452C1.66 10.67 4.268 13.278 7.485 13.278C10.02 13.278 12.18 11.65 12.987 9.388C12.103 10.199 10.899 10.706 9.57 10.706C6.884 10.706 4.706 8.528 4.706 5.842C4.706 4.542 5.193 3.364 5.976 2.493C3.541 3.195 1.66 5.128 1.66 7.453Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/></svg>
                    </button>
                    <button class="action-icon-btn" type="button"><svg viewBox="0 0 24 24"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9M13.73 21a2 2 0 0 1-3.46 0"></path></svg></button>
                    <a class="profile-chip" href="/profile">
                        <span class="avatar"><%= user.initials %></span>
                        <span class="profile-name"><%= user.name %></span>
                    </a>
                    <a class="primary-action-btn" href="/services/url-shortener">
                        <svg viewBox="0 0 24 24" style="width:1.25rem;height:1.25rem;stroke:currentColor;stroke-width:2.5;fill:none;"><path d="M12 5v14M5 12h14"></path></svg>
                        Create Link
                    </a>
                </div>
            </header>

            <section class="content">
                <div class="dashboard-head">
                    <div>
                        <h1>Dashboard</h1>
                        <p>Welcome back, <%= user.name %>.</p>
                    </div>
                </div>

                <div class="stats-grid" id="analytics">
                    <article class="stat-card-retro">
                        <span class="card-id">STAT_01</span>
                        <span class="label">Total Links</span>
                        <span class="value"><%= dashboardData.stats.totalLinks || 32 %></span>
                        <span class="subtext"><span class="trend">+12%</span> from last month</span>
                    </article>
                    <article class="stat-card-retro accent-blue">
                        <span class="card-id">STAT_02</span>
                        <span class="label">Total Clicks</span>
                        <span class="value"><%= dashboardData.stats.totalClicks || 1256 %></span>
                        <span class="subtext"><span class="trend">+18%</span> from last month</span>
                    </article>
                    <article class="stat-card-retro">
                        <span class="card-id">STAT_03</span>
                        <span class="label">Top Performing</span>
                        <span class="value"><%= dashboardData.stats.topPerforming || 423 %></span>
                        <span class="subtext">Clicks accumulated</span>
                    </article>
                    <article class="stat-card-retro">
                        <span class="card-id">STAT_04</span>
                        <span class="label">Joined On</span>
                        <span class="value" style="font-size:2.2rem;margin-top:0.75rem;"><%= dashboardData.stats.joinedOn || '24 May' %></span>
                        <span class="subtext">Active Creator</span>
                    </article>
                </div>

                <section class="panel-retro">
                    <div class="panel-retro-title-row">
                        <h2>Invite Status</h2>
                        <span class="badge-retro">Team invites</span>
                    </div>
                    <div class="status-grid-retro">
                        <div class="status-card-retro pending">
                            <h3>Pending</h3>
                            <p><%= inviteSummary ? inviteSummary.pending : 0 %></p>
                        </div>
                        <div class="status-card-retro accepted">
                            <h3>Accepted</h3>
                            <p><%= inviteSummary ? inviteSummary.accepted : 0 %></p>
                        </div>
                        <div class="status-card-retro expired">
                            <h3>Expired</h3>
                            <p><%= inviteSummary ? inviteSummary.expired : 0 %></p>
                        </div>
                    </div>
                </section>

                <div class="analytics-grid">
                    <section class="panel-retro">
                        <div class="panel-retro-title-row">
                            <h2>Clicks Overview</h2>
                            <select class="badge-retro" style="cursor:pointer;background:var(--accent-teal);font-family:'Space Grotesk',sans-serif;font-weight:700;padding:0.2rem 0.4rem;">
                                <option>Last 7 Days</option>
                                <option>Last 30 Days</option>
                            </select>
                        </div>
                        <div class="chart-wrap" style="height:260px;position:relative;">
                            <canvas id="clicksChart"></canvas>
                        </div>
                    </section>

                    <div style="display:flex;flex-direction:column;gap:1.5rem;">
                        <section class="panel-retro">
                            <div class="panel-retro-title-row">
                                <h2>Accept Invite</h2>
                                <span class="badge-retro">Team</span>
                            </div>
                            <p style="font-size:0.85rem;color:var(--muted-2);">Paste your token below.</p>
                            <% if (typeof inviteAcceptMessage !== 'undefined' && inviteAcceptMessage) { %>
                                <div class="message-box message-success"><%= inviteAcceptMessage %></div>
                            <% } %>
                            <% if (typeof inviteAcceptError !== 'undefined' && inviteAcceptError) { %>
                                <div class="message-box message-error"><%= inviteAcceptError %></div>
                            <% } %>
                            <form class="invite-form" action="/dashboard/accept-invite" method="POST">
                                <input type="text" name="inviteToken" placeholder="Invite token" required autocomplete="off" />
                                <button type="submit">Accept</button>
                            </form>
                        </section>

                        <section class="panel-retro">
                            <div class="panel-retro-title-row">
                                <h2>Top Referrers</h2>
                            </div>
                            <div class="chart-wrap" style="height:180px;position:relative;">
                                <canvas id="referrersChart"></canvas>
                            </div>
                        </section>
                    </div>
                </div>

                <section class="panel-retro" id="recent-links" style="padding:0;overflow:hidden;">
                    <div class="panel-retro-title-row" style="padding:1.25rem 1.5rem 1rem;margin-bottom:0;">
                        <h2>Recent Links</h2>
                        <a href="/services/url-shortener" class="badge-retro" style="text-decoration:none;color:#111111;">View all links</a>
                    </div>
                    <div class="table-scroll">
                        <table class="recent-links-table">
                            <thead>
                                <tr>
                                    <th>Original URL</th>
                                    <th>Short URL</th>
                                    <th>Clicks</th>
                                    <th>Status</th>
                                    <th>Created At</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% if (dashboardData.recentLinks && dashboardData.recentLinks.length > 0) { %>
                                    <% dashboardData.recentLinks.forEach(link => { %>
                                        <tr>
                                            <td><%= link.originalUrl %></td>
                                            <td class="short-url">creatoros.link/<%= link.shortUrl %></td>
                                            <td style="font-family:'Space Grotesk',sans-serif;font-weight:700;"><%= link.clicks %></td>
                                            <td><span class="qr-badge">Ready</span></td>
                                            <td><%= link.date %></td>
                                            <td>
                                                <div class="row-actions">
                                                    <a class="row-action" href="/services/url-shortener"><svg viewBox="0 0 24 24"><path d="M4 19V5M9 19v-6M14 19V9M19 19V3"></path></svg></a>
                                                    <a class="row-action" href="/services/url-shortener"><svg viewBox="0 0 24 24"><path d="M12 20h9M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4Z"></path></svg></a>
                                                </div>
                                            </td>
                                        </tr>
                                    <% }) %>
                                <% } else { %>
                                    <tr>
                                        <td>https://example.com/awesome-video</td>
                                        <td class="short-url">creatoros.link/abc123</td>
                                        <td style="font-family:'Space Grotesk',sans-serif;font-weight:700;">342</td>
                                        <td><span class="qr-badge">Ready</span></td>
                                        <td>24 May 2025</td>
                                        <td>
                                            <div class="row-actions">
                                                <a class="row-action" href="/services/url-shortener"><svg viewBox="0 0 24 24"><path d="M4 19V5M9 19v-6M14 19V9M19 19V3"></path></svg></a>
                                                <a class="row-action" href="/services/url-shortener"><svg viewBox="0 0 24 24"><path d="M12 20h9M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4Z"></path></svg></a>
                                            </div>
                                        </td>
                                    </tr>
                                <% } %>
                            </tbody>
                        </table>
                    </div>
                </section>
            </section>
        </main>
    </div>

    <!-- QR Modal -->
    <div class="qr-modal-wrap" id="qrModal" role="dialog" aria-modal="true" aria-labelledby="qrModalTitle">
        <div class="qr-backdrop" id="qrBackdrop"></div>
        <div class="qr-modal">
            <div class="qr-modal-head">
                <div>
                    <h3 id="qrModalTitle">QR Code</h3>
                    <p id="qrModalUrl"></p>
                </div>
                <button class="qr-close" id="qrClose" aria-label="Close QR modal">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M18 6 6 18"></path><path d="m6 6 12 12"></path></svg>
                </button>
            </div>
            <div class="qr-preview" id="qrPreview">
                <div class="qr-preview-placeholder" id="qrPlaceholder">
                    <div class="qr-spinner"></div>
                    <span>Generating QR…</span>
                </div>
            </div>
            <div class="qr-colors">
                <div class="qr-color-field">
                    <label for="qrFg">Foreground</label>
                    <div class="qr-color-row">
                        <input type="color" id="qrFgPicker" value="#000000" title="Foreground color">
                        <input type="text" id="qrFg" value="#000000" maxlength="7" placeholder="#000000">
                    </div>
                </div>
                <div class="qr-color-field">
                    <label for="qrBg">Background</label>
                    <div class="qr-color-row">
                        <input type="color" id="qrBgPicker" value="#ffffff" title="Background color">
                        <input type="text" id="qrBg" value="#ffffff" maxlength="7" placeholder="#ffffff">
                    </div>
                </div>
            </div>
            <div class="qr-actions">
                <a class="qr-btn qr-btn-primary" id="qrDownload" href="#" download>
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="7 10 12 15 17 10"></polyline><line x1="12" y1="15" x2="12" y2="3"></line></svg>
                    Download PNG
                </a>
                <button class="qr-btn qr-btn-secondary" id="qrApplyColors">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M12 20h9"></path><path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4Z"></path></svg>
                    Apply Colors
                </button>
            </div>
        </div>
    </div>

    <script src="/js/pages/dashboard.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const themeBtn = document.getElementById('theme-toggle');
            const root = document.documentElement;
            const iconLight = themeBtn ? themeBtn.querySelector('.icon-light') : null;
            const iconDark  = themeBtn ? themeBtn.querySelector('.icon-dark')  : null;

            function applyTheme(isDark) {
                if (isDark) {
                    root.setAttribute('data-theme', 'dark');
                    if (iconLight) iconLight.style.display = 'none';
                    if (iconDark)  iconDark.style.display  = 'block';
                } else {
                    root.removeAttribute('data-theme');
                    if (iconLight) iconLight.style.display = 'block';
                    if (iconDark)  iconDark.style.display  = 'none';
                }
            }

            if (themeBtn) {
                applyTheme(localStorage.getItem('theme') === 'dark');
                themeBtn.addEventListener('click', () => {
                    const isDark = root.getAttribute('data-theme') === 'dark';
                    applyTheme(!isDark);
                    localStorage.setItem('theme', !isDark ? 'dark' : 'light');
                    window.dispatchEvent(new Event('themeChanged'));
                });
            }

            const sidebarBtn = document.getElementById('sidebarToggle');
            const layout     = document.getElementById('dashboardLayout');
            if (sidebarBtn) {
                sidebarBtn.addEventListener('click', () => layout.classList.toggle('sidebar-collapsed'));
            }

            const ctxClicks = document.getElementById('clicksChart');
            if (ctxClicks) {
                new Chart(ctxClicks, {
                    type: 'line',
                    data: {
                        labels: ['18 May','19 May','20 May','21 May','22 May','23 May','24 May'],
                        datasets: [{
                            label: 'Clicks',
                            data: [100, 180, 220, 160, 300, 250, 423],
                            borderColor: '#111111',
                            backgroundColor: 'rgba(55,214,200,0.12)',
                            borderWidth: 3,
                            pointBackgroundColor: '#37D6C8',
                            pointBorderColor: '#111111',
                            pointBorderWidth: 2,
                            pointRadius: 5,
                            pointHoverRadius: 7,
                            tension: 0,
                            fill: true
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        scales: {
                            y: {
                                grid: { color: 'rgba(0,0,0,0.07)', lineWidth: 1 },
                                border: { color: '#111111', width: 2 },
                                ticks: { font: { family: 'Space Grotesk', weight: '700', size: 11 } }
                            },
                            x: {
                                grid: { display: false },
                                border: { color: '#111111', width: 2 },
                                ticks: { font: { family: 'Space Grotesk', weight: '700', size: 11 } }
                            }
                        },
                        plugins: { legend: { display: false } }
                    }
                });
            }

            const ctxRef = document.getElementById('referrersChart');
            if (ctxRef) {
                new Chart(ctxRef, {
                    type: 'doughnut',
                    data: {
                        labels: ['Direct', 'Google', 'Twitter'],
                        datasets: [{
                            data: [65, 20, 15],
                            backgroundColor: ['#37D6C8', '#76A9FA', '#E4C13B'],
                            borderColor: '#111111',
                            borderWidth: 2,
                            hoverOffset: 4
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: {
                            legend: {
                                position: 'right',
                                labels: {
                                    color: '#111111',
                                    font: { family: 'Space Grotesk', weight: 'bold', size: 12 },
                                    boxWidth: 12,
                                    padding: 10
                                }
                            }
                        }
                    }
                });
            }
        });
    </script>
</body>
</html>
